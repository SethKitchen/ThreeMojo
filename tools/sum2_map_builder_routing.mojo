def _fail(message: String) raises:
    """Raise a map-builder routing error.

    Args:
        message: The failure text.

    Raises:
        Error: The live map-builder routing changed.
    """
    raise Error(message)


def _count(text: String, needle: String) -> Int:
    """Return how many times `needle` occurs in `text`.

    Args:
        text: The source.
        needle: The exact byte sequence.

    Returns:
        The number of non-overlapping matches.
    """
    var count = 0
    var offset = 0
    var size = text.byte_length()
    var step = needle.byte_length()
    while offset < size:
        var rest = String(text[byte=offset:])
        var at = rest.find(needle)
        if at < 0:
            return count
        count += 1
        offset += at + step
    return count


def _left(index: Int) -> String:
    """Return one live routing span.

    Args:
        index: The span number.

    Returns:
        The live routing text.
    """
    if index == 0:
        return _LEFT_0
    if index == 1:
        return _LEFT_1
    if index == 2:
        return _LEFT_2
    if index == 3:
        return _LEFT_3
    if index == 4:
        return _LEFT_4
    if index == 5:
        return _LEFT_5
    if index == 6:
        return _LEFT_6
    return _LEFT_7


def _right(index: Int) -> String:
    """Return one pinned routing span.

    Args:
        index: The span number.

    Returns:
        The pinned routing text.
    """
    if index == 0:
        return _RIGHT_0
    if index == 1:
        return _RIGHT_1
    if index == 2:
        return _RIGHT_2
    if index == 3:
        return _RIGHT_3
    if index == 4:
        return _RIGHT_4
    if index == 5:
        return _RIGHT_5
    if index == 6:
        return _RIGHT_6
    return _RIGHT_7


def sum2_map_builder_routing(root: String) raises:
    """Require the live map-builder routing.

    Args:
        root: The repository root.

    Raises:
        Error: A reviewed span or the pinned routing changed.
    """
    var base = root
    if base.byte_length() > 1 and base.endswith("/"):
        var end = base.byte_length() - 1
        var trimmed = String(base[byte=0:end])
        base = trimmed
    var doc = PyJson.parse(Path(base + "/" + _PINS).read_text())
    var callers = doc.at(doc.root, "callers")
    var record = doc.at(callers, "map_builder")
    var routing = doc.at(record, "routing")
    if doc.kind(routing) != PY_STR:
        _fail(_MESSAGE)
    var current = _routing(Path(base + "/" + _BUILDER).read_text())
    var index = 0
    while index < 8:
        var left = _left(index)
        if _count(current, left) != 1:
            _fail(_MESSAGE)
        current = current.replace(left, _right(index))
        index += 1
    if current != doc.text(routing):
        _fail(_MESSAGE)
