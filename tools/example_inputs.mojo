"""Write the `make` prerequisites of each example.

    example_inputs --output .cache/example-inputs.mk
    example_inputs --check-repository

writes `EXAMPLE_INPUTS_NAME := PATH...` for each `examples/NAME.mojo`. The
paths are the files the example imports, directly or through other files,
the assets it quotes, the PNG optimizer that each gallery recipe runs and
its imports, and the files that write these rules. So an image is drawn
again only when something it uses changes. The library lists keep every
extension for lint and coverage.

With `--check-repository`, the tool checks the gallery instead: each line
of `examples/gallery.mk` names an example that exists, every example has a
gallery line or its own recipe, and every gallery image is compressed.
`make repository-check` runs this check.

A change to an external asset cache is not seen: use `make -B` after one.
The file is written only when its text changes, and it is replaced in one
step, so `make` processes that run at once are safe.
"""

from std.collections import Set
from std.ffi import c_int, external_call
from std.os import makedirs, remove
from std.os.path import dirname
from std.pathlib import Path
from std.sys import argv, exit, stderr

from tools._imports import SourceCache, closure, mojo_files, sorted_set
from tools._text import split_lines
from tools.suite_key import asset_files

comptime TOOLS = ["Makefile", "examples/gallery.mk", "tools/tool.sh"]
"""The files besides this tool's own sources that decide the rules."""

comptime SELF = "tools/example_inputs.mojo"
"""This tool. Its import closure is part of every example's inputs."""

comptime OPTIMIZER = "tools/optimize_png.mojo"
"""The program each gallery recipe runs on its image."""


def _stem(path: String) -> String:
    """Return a file name without its directory and its last suffix."""
    var name = String(path[byte = path.rfind("/") + 1 :])
    var dot = name.rfind(".")
    if dot > 0:
        return String(name[byte=:dot])
    return name


def dependencies(root: String) raises -> Dict[String, List[String]]:
    """Return each example's prerequisites.

    Args:
        root: The repository root.

    Returns:
        Each example's name and its sorted prerequisites.

    Raises:
        Error: If a reached source cannot be read.
    """
    var known = Set[String]()
    for path in mojo_files(root):
        known.add(path)
    var cache = SourceCache()
    var assets = asset_files(root)
    var shared = Set[String]()
    for path in materialize[TOOLS]():
        shared.add(path)
    for tool in [SELF, OPTIMIZER]:
        if tool in known:
            for path in closure(root, tool, known, cache):
                shared.add(path)
    var examples = List[String]()
    for path in known:
        if path.startswith("examples/"):
            examples.append(path)
    var result = Dict[String, List[String]]()
    for example in sorted_set(Set[String](examples)):
        var inputs = shared.copy()
        var quoted = Set[String]()
        for path in closure(root, example, known, cache):
            inputs.add(path)
            for prefix in cache.assets[path]:
                quoted.add(prefix)
        for path in assets:
            for prefix in quoted:
                if path.startswith(prefix):
                    inputs.add(path)
                    break
        result[_stem(example)] = sorted_set(inputs)
    return result^


def makefile_text(inputs: Dict[String, List[String]]) raises -> String:
    """Write prerequisites as `make` variable assignments.

    Args:
        inputs: Each example's name and its prerequisites.

    Returns:
        One assignment for each example, in name order, after a header.

    Raises:
        Error: If a name or a path holds white space, `#`, `$`, `:` or a
            backslash, which `make` would read as syntax.
    """
    var names = List[String]()
    for entry in inputs.items():
        names.append(entry.key)
    var text = String(
        "# Generated by tools/example_inputs.mojo; do not edit.\n"
    )
    for name in sorted_set(Set[String](names)):
        var paths = inputs[name].copy()
        var tokens: List[String] = [name]
        tokens.extend(paths.copy())
        for token in tokens:
            for byte in token.as_bytes():
                if (
                    byte == 32
                    or (byte >= 9 and byte <= 13)
                    or (byte >= 28 and byte <= 31)
                    or byte == 35
                    or byte == 36
                    or byte == 58
                    or byte == 92
                ):
                    raise Error("unsupported Make prerequisite path: " + token)
        text += "EXAMPLE_INPUTS_" + name + " := " + " ".join(paths) + "\n"
    return text^


def write_if_changed(path: String, text: String) raises -> Bool:
    """Replace a file in one step when its text changes.

    Args:
        path: The file.
        text: The new text.

    Returns:
        True when the file was written.

    Raises:
        Error: If the file cannot be written or renamed.
    """
    if Path(path).exists() and Path(path).read_text() == text:
        return False
    var directory = dirname(path)
    if directory and not Path(directory).exists():
        makedirs(directory, exist_ok=True)
    var pid = external_call["getpid", c_int]()
    var temporary = path + ".example-inputs-" + String(pid)
    try:
        Path(temporary).write_text(text)
        # C strings need a terminating NUL, which these copies get.
        var source = temporary
        var target = path
        if (
            external_call["rename", c_int](
                source.as_c_string_span().ptr(),
                target.as_c_string_span().ptr(),
            )
            != 0
        ):
            raise Error("cannot rename " + temporary + " to " + path)
    finally:
        if Path(temporary).exists():
            remove(Path(temporary))
    return True


def _is_name(text: String, dash: Bool) -> Bool:
    """Return whether text is one or more word characters, or dashes."""
    if text.byte_length() == 0:
        return False
    for byte in text.as_bytes():
        var word = (
            (byte >= 48 and byte <= 57)
            or (byte >= 65 and byte <= 90)
            or (byte >= 97 and byte <= 122)
            or byte == 95
        )
        if not word and not (dash and byte == 45):
            return False
    return True


def gallery_entries(table: String, mut errors: List[String]) -> List[String]:
    """Return the example of each line of the gallery table.

    Args:
        table: The text of `examples/gallery.mk`.
        errors: Gets a line for each line that is not a comment, not blank
            and not `$(call gallery,IMAGE,EXAMPLE[,PREREQUISITES])`.

    Returns:
        The example names, in table order.
    """
    var examples = List[String]()
    for raw in split_lines(table):
        var line = raw
        if line.byte_length() == 0 or line.startswith("#"):
            continue
        var valid = line.startswith("$(call gallery,") and line.endswith(")")
        if valid:
            var fields = String(line[byte = 15 : line.byte_length() - 1]).split(
                ",", 2
            )
            valid = (
                len(fields) >= 2
                and _is_name(String(fields[0]), True)
                and _is_name(String(fields[1]), False)
                and (len(fields) < 3 or String(fields[2]).find(")") < 0)
            )
            if valid:
                examples.append(String(fields[1]))
        if not valid:
            errors.append("examples/gallery.mk: not a gallery line: " + line)
    return examples^


def _recipe(makefile: String, target: String) -> String:
    """Return a rule from its target line to the next blank line."""
    var start = makefile.find(target)
    if start < 0:
        return String()
    var end = makefile.find("\n\n", start)
    if end < 0:
        end = makefile.byte_length()
    return String(makefile[byte=start:end])


def repository_errors(root: String) raises -> List[String]:
    """Check that the gallery draws and compresses every example.

    Args:
        root: The repository root.

    Returns:
        A line for each problem, or none.

    Raises:
        Error: If the `Makefile` or the table cannot be read.
    """
    var errors = List[String]()
    var makefile = Path(root + "/Makefile").read_text()
    var table = Path(root + "/examples/gallery.mk").read_text()
    var tabled = Set[String]()
    for example in gallery_entries(table, errors):
        if not Path(root + "/examples/" + example + ".mojo").is_file():
            errors.append(
                "examples/gallery.mk: no examples/" + example + ".mojo"
            )
        tabled.add(example)
    for path in mojo_files(root):
        if not path.startswith("examples/") or path.find("/", 9) >= 0:
            continue
        var name = _stem(path)
        # The viewer is an interactive terminal program, with no image.
        if name == "viewer" or name in tabled:
            continue
        if makefile.find("$(EXAMPLE_INPUTS_" + name + ")") < 0:
            errors.append(path + ": no gallery line or recipe")
    var start = makefile.find("define GALLERY_RULE")
    var end = makefile.find("# Deliberately leaves", start)
    if start < 0 or end < 0:
        errors.append("Makefile: no gallery section")
        return errors^
    var gallery = String(makefile[byte=start:end])
    if (gallery + table).find("$(LIB_SOURCES)") >= 0:
        errors.append("an image depends on every library source")
    for name in ["carla", "carla_town", "carla_towns"]:
        var recipe = _recipe(gallery, "$(OUT_DIR)/" + name + ".png:")
        if (
            recipe.find("credits --all --output $(@:.png=.credits.md)") < 0
            or recipe.find("assets/carla/ATTRIBUTION.md") < 0
        ):
            errors.append(
                "Makefile: " + name + ".png does not write its credits"
            )
    if gallery.count("call run,") != gallery.count("tools/optimize_png.mojo $"):
        errors.append("Makefile: a gallery image is not compressed")
    if makefile.find("include examples/gallery.mk") < 0:
        errors.append("Makefile: examples/gallery.mk is not included")
    var face = _recipe(makefile, "$(OUT_DIR)/audio-character.glb:")
    if (
        face.find("$(EXAMPLE_INPUTS_audio_game_humanoid)") < 0
        or face.find("examples/audio_game_humanoid.mojo $@") < 0
        or face.find("optimize_png") >= 0
    ):
        errors.append("Makefile: the audio game face recipe is wrong")
    return errors^


def main() raises:
    var given = argv()
    var output = String()
    var check = False
    var index = 1
    while index < len(given):
        var argument = String(given[index])
        if argument == "--check-repository":
            check = True
        elif argument == "--output" and index + 1 < len(given):
            index += 1
            output = String(given[index])
        elif argument.startswith("--output="):
            output = String(argument[byte=9:])
        else:
            print("example_inputs: unknown argument:", argument, file=stderr)
            exit(2)
        index += 1
    if check:
        var errors = repository_errors(".")
        for error in errors:
            print("example_inputs:", error, file=stderr)
        exit(1 if len(errors) > 0 else 0)
        return
    if not output:
        print("example_inputs: --output is required", file=stderr)
        exit(2)
    try:
        _ = write_if_changed(output, makefile_text(dependencies(".")))
    except error:
        print("example_inputs:", error, file=stderr)
        exit(2)
