"""The game display's font: Barlow Semi Condensed SemiBold, as a
signed distance field a glyph. `assets/fonts/make_hud_font.py`
writes this file. Do not edit it by hand.

The font is Copyright 2017 The Barlow Project Authors, under the
SIL Open Font License 1.1: see `assets/fonts/barlow/OFL.txt`.
"""

comptime FONT_CELL = 32
"""The side of a glyph's square cell, in samples."""
comptime FONT_CAP = Float32(18.0)
"""The height of a capital letter, in samples."""
comptime FONT_BASE = Float32(25.0)
"""How far down its cell a glyph's baseline is, in samples."""
comptime FONT_PAD = Float32(5.0)
"""How far in from its cell's left side a glyph's origin is, in
samples."""
comptime FONT_SPREAD = Float32(6.0)
"""The distance, in samples, of the field's least and greatest
levels from a glyph's edge."""
comptime FONT_FIRST = 35
"""The character code of the field's least level."""
comptime FONT_LEVELS = 57
"""How many levels a sample of the field takes."""
comptime FONT_SPACE = Float32(5.1429)
"""The advance of a space, in samples."""
