# The exponential inside `pow` (exp_data.c).

# 128 / ln 2.
comptime EXP_INV_LN2_N: UInt64 = 0x40671547652B82FE
# The high part of -ln 2 / 128.
comptime EXP_NEG_LN2_HI_N: UInt64 = 0xBF762E42FEFA0000
# The low part of -ln 2 / 128.
comptime EXP_NEG_LN2_LO_N: UInt64 = 0xBD0CF79ABC9E3B3A
# 1.5 * 2^52, which rounds to an integer.
comptime EXP_SHIFT: UInt64 = 0x4338000000000000
# The last four coefficients of the polynomial of exp(r).
comptime EXP_POLY: Array[UInt64, 4] = [
    0x3FDFFFFFFFFFFDBD,
    0x3FC555555555543C,
    0x3FA55555CF172B91,
    0x3F81111167A4D017,
]
