#
# The values are those of math/pow_log_data.c, math/exp_data.c and
# math/log_data.c of Arm's optimized routines, commit 9a0d5027, as the
# bits of each double. Copyright (c) 2018 Arm Limited. MIT license: see
# THIRD-PARTY-NOTICES.md.

"""The tables of `glibc_pow` and `glibc_log` in `extensions/numerics/libm.mojo`.

Each value is the bits of a double. `libm.mojo` binds a table with
`global_constant` and casts each word with `bitcast`. The tables have 128
parts each, as glibc builds them on a machine with fused multiply-add.
"""

# The logarithm inside `pow` (pow_log_data.c).

# The high part of ln 2.
comptime POW_LN2_HI: UInt64 = 0x3FE62E42FEFA3800
# The low part of ln 2.
comptime POW_LN2_LO: UInt64 = 0x3D2EF35793C76730
# The polynomial of log1p(r) - r, scaled as pow evaluates it.
comptime POW_POLY: Array[UInt64, 7] = [
    0xBFE0000000000000,
    0xBFE5555555555560,
    0x3FE0000000000006,
    0x3FE999999959554E,
    0xBFE555555529A47A,
    0xBFF2495B9B4845E9,
    0x3FF0002B8B263FC3,
]
