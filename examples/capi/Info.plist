  The macOS host runs inside this bundle so that Launch Services starts it.
  A program that a shell starts cannot take focus on macOS 14 and later, so
  its window opens behind the terminal.
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>dev.threemojo.host</string>
  <key>CFBundleName</key><string>ThreeMojo</string>
  <key>CFBundleExecutable</key><string>threemojo_host</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
