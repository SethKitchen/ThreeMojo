# Mojo toolchain, installed per-checkout by `uv pip install mojo`.
# The README covers recreating it; it must never be committed.
.venv/
.venv-mojo10/

# Instrumented copies of the sources, plus the manifest and captured probe
# records. Regenerated from scratch by every `make coverage`.
coverage/build/

# Regenerated dumps. The APNG figures in out/ are committed so the wiki
# can show them.
/out/*
!/out/*.png
*.ppm

# Compiled binaries from `mojo build`.
*.o
*.dylib
*.so
bench/build/
bench/scratch/
bench/threejs/node_modules/

# Agent skills vendored from github per skills-lock.json. The lockfile is
# committed so the versions are reproducible; the fetched content is not,
# the same way a lockfile is tracked but its packages are not.
.claude/skills/
.agents/skills/

# Editor and OS noise. .vscode/settings.json is deliberately NOT ignored: it
# carries the mojo.lsp.includeDirs fix every contributor needs.
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
*.swp

# Python bytecode, from the formatter's dependencies.
__pycache__/
*.py[cod]
.cache/
