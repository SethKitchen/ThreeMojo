BEGIN options

END options
BEGIN nonlinear
  OUTER_DVCLOSE 1.0e-8
  OUTER_MAXIMUM 200
  UNDER_RELAXATION DBD
  UNDER_RELAXATION_THETA 0.7
  UNDER_RELAXATION_KAPPA 0.1
  UNDER_RELAXATION_GAMMA 0.2
  UNDER_RELAXATION_MOMENTUM 0.001
  BACKTRACKING_NUMBER 5
  BACKTRACKING_TOLERANCE 1.0
  BACKTRACKING_REDUCTION_FACTOR 0.3
  BACKTRACKING_RESIDUAL_LIMIT 1.0e-4
END nonlinear
BEGIN linear
  INNER_MAXIMUM 300
  INNER_DVCLOSE 1.0e-9
  INNER_RCLOSE 1.0e-6 L2NORM_RCLOSE
  LINEAR_ACCELERATION BICGSTAB
  RELAXATION_FACTOR 0.97
  SCALING_METHOD DIAGONAL
END linear
