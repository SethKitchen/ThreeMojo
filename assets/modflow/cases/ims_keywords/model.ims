BEGIN options
  COMPLEXITY MODERATE
  PRINT_OPTION SUMMARY
END options
BEGIN nonlinear
  OUTER_DVCLOSE 1.0e-8
  OUTER_MAXIMUM 300
  UNDER_RELAXATION NONE
  LINEAR_SOLVER DEFAULT
END nonlinear
BEGIN linear
  INNER_MAXIMUM 300
  INNER_DVCLOSE 1.0e-9
  INNER_RCLOSE 1.0e-6
  LINEAR_ACCELERATION BICGSTAB
  SCALING_METHOD NONE
  RED_BLACK_ORDERING
  REORDERING_METHOD NONE
END linear
