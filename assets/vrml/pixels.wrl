#VRML V2.0 utf8
# Pixel textures of one to four components, and their effect on the
# material.

DEF ONE Shape {
  appearance Appearance {
    material Material { diffuseColor 1 0 0 transparency 0.5 }
    texture DEF I PixelTexture { image 2 2 1 0xFF 128 0x1FF 3.7 repeatT FALSE }
  }
  geometry Box { }
}
Shape {
  appearance Appearance {
    material Material { diffuseColor 1 0 0 transparency 0.5 }
    texture PixelTexture { image 2 1 2 0xFF80 0x8 }
  }
  geometry Box { }
}
Shape {
  appearance Appearance {
    material Material { diffuseColor 1 0 0 transparency 0.5 }
    texture PixelTexture { image 2 2 3 0xFF0000 0x00FF00 0x0000FF 0x123 0xABCDEF repeatS FALSE repeatT FALSE }
    textureTransform TextureTransform { center 0.5 0.5 }
  }
  geometry Box { }
}
Shape {
  appearance Appearance {
    material Material { diffuseColor 1 0 0 transparency 0.5 }
    texture PixelTexture { image 1 1 4 0xFF000080 }
  }
  geometry Box { }
}
Shape {
  appearance Appearance {
    texture PixelTexture { image 1 1 5 0xFF000080 }
  }
  geometry Box { }
}
Shape {
  appearance Appearance {
    texture PixelTexture { image 0 0 0 }
    material Material { }
  }
  geometry Box { }
}
Shape {
  appearance Appearance { material NULL texture PixelTexture { repeatS FALSE } }
  geometry Box { }
}
Shape {
  appearance Appearance { material NULL texture ImageTexture { url "" } }
  geometry Box { }
}
Shape {
  appearance Appearance { texture ImageTexture { url "missing.png" repeatT FALSE } }
  geometry Box { }
}
