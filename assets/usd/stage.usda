#usda 1.0
(
    defaultPrim = "Scene"
)

def Xform "Scene"
{
    def Xform "Thing" (
        prepend references = @./geo.usda@</Shape>
    )
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Looks/Painted>
    }

    def Xform "Whole" (
        prepend references = @parts/geo.usdc@
    )
    {
    }

    def Xform "Loaded" (
        payload = @parts/geo.usdc@</Shape>
    )
    {
    }

    def Xform "Pick" (
        prepend references = @parts/variants.usdc@
        variants = {
            string color = "green"
        }
    )
    {
    }

    def Xform "Default" (
        prepend references = @parts/variants.usdc@
    )
    {
    }

    def Xform "Gone" (
        prepend references = @nothere.usda@
    )
    {
    }
}

def Scope "Looks"
{
    def Material "Painted"
    {
        token outputs:surface.connect = </Looks/Painted/PBR.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Looks/Painted/Color.outputs:rgb>
            color3f inputs:emissiveColor.connect = </Looks/Painted/Glow.outputs:rgb>
            normal3f inputs:normal.connect = </Looks/Painted/Bumps.outputs:rgb>
            float inputs:roughness.connect = </Looks/Painted/Color.outputs:r>
            float inputs:metallic.connect = </Looks/Painted/Color.outputs:g>
            float inputs:occlusion.connect = </Looks/Painted/Color.outputs:b>
            color3f inputs:specularColor.connect = </Looks/Painted/Glow.outputs:rgb>
            float inputs:opacity.connect = </Looks/Painted/Color.outputs:a>
            token outputs:surface
        }

        def Shader "Reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st1"
            float2 outputs:result
        }

        def Shader "Place"
        {
            uniform token info:id = "UsdTransform2d"
            float2 inputs:in.connect = </Looks/Painted/Reader.outputs:result>
            float inputs:rotation = 45
            float2 inputs:scale = (2, 3)
            float2 inputs:translation = (0.25, 0.5)
            float2 outputs:result
        }

        def Shader "Color"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/brick.png@
            float2 inputs:st.connect = </Looks/Painted/Place.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "mirror"
            float4 inputs:scale = (0.5, 0.5, 0.5, 1)
            float4 inputs:bias = (0, 0, 0, 0)
            float3 outputs:rgb
        }

        def Shader "Glow"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/brick.png@
            float2 inputs:st.connect = </Looks/Painted/Reader.outputs:result>
            token inputs:wrapS = "clamp"
            token inputs:wrapT = "black"
            float3 outputs:rgb
        }

        def Shader "Bumps"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @other/brick.png@
            float4 inputs:scale = (2, 2, 1, 1)
            float3 outputs:rgb
        }
    }
}
