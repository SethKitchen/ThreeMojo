@fieldwise_init
struct _EvenNumericalSegments(ImplicitlyCopyable, SegmentFilter):
    def accepts(self, entry: SegmentElement) -> Bool:
        return entry.start_value % 2 == 0


def test_public_nearest_prefixes_filters_and_bounds() raises:
    var tree = SegmentCloudRtree()
    var large = Float32(1e38)
    tree.insert_element(Vector3(-large, 0, 0), Vector3(-1, 0, 0), 0, 100)
    tree.insert_element(Vector3(-1, 0, 0), Vector3(-large, 0, 0), 1, 101)
    tree.insert_element(Vector3(0.5, 0, 0), Vector3(0.5, 0, 0), 2, 102)
    tree.insert_element(Vector3(-0.5, 0, 0), Vector3(-0.5, 0, 0), 3, 103)
    tree.insert_element(Vector3(0, 0, 0.25), Vector3(0, 0, 0.25), 4, 104)
    tree.insert_element(
        Vector3(-large, -large, 0), Vector3(large, large, 0), 5, 105
    )
    tree.insert_element(
        Vector3(large, large, 0), Vector3(-large, -large, 0), 6, 106
    )
    # Fill multiple leaves; every filler is strictly farther than distance 1.
    for i in range(7, 87):
        var p = Vector3(Float32(i), Float32(i % 5), Float32(i % 3))
        tree.insert_element(p, p, i, i + 100)
    var query = Vector3(0, 0, 0)
    var first = [5, 6, 4, 2, 3, 0, 1]
    for count in [1, 2, 3, 7, 20, 87, 100]:
        var got = tree.get_nearest_neighbours(query, count)
        assert_equal(len(got), min(count, 87))
        for i in range(min(count, 7)):
            assert_equal(got[i].start_value, first[i])
            assert_equal(got[i].end_value, first[i] + 100)
        for i in range(7, len(got)):
            assert_equal(got[i].start_value, i)
    var expected = [6, 4, 2, 0]
    for count in [1, 2, 4, 20, 100]:
        var filtered = tree.get_nearest_neighbours_with_filter(
            query, _EvenNumericalSegments(), count
        )
        assert_equal(len(filtered), min(count, 44))
        for i in range(min(count, 4)):
            assert_equal(filtered[i].start_value, expected[i])
        for i in range(4, len(filtered)):
            assert_equal(filtered[i].start_value, 2 * i)
    var hits = tree.get_intersections(
        Box3(Vector3(-0.5, -0.5, -0.5), Vector3(0.5, 0.5, 0.5))
    )
    assert_equal(len(hits), 5)
    for i in range(5):
        assert_equal(hits[i].start_value, i + 2)
    # Verify every node lower bound against every descendant key, including
    # extreme inputs, exact endpoint gaps and reversed insertion ties.
    for n in range(len(tree._tree.nodes)):
        var pending = List[Int]()
        pending.append(n)
        var lower = _box_distance2(tree._tree.nodes[n].box, query)
        while len(pending) > 0:
            var child = pending.pop()
            ref node = tree._tree.nodes[child]
            for entry in node.children:
                if node.leaf:
                    assert_true(
                        lower
                        <= _segment_distance2(
                            tree._tree.starts[entry],
                            tree._tree.ends[entry],
                            query,
                        )
                    )
                else:
                    pending.append(entry)


def test_near_endpoint_interior_public_nearest() raises:
    var tree = SegmentCloudRtree()
    var large = Float32(1e38)
    # A snapped t=1 gives distance 2 instead of 1 for this interior foot.
    tree.insert_element(Vector3(-large, 0, 0), Vector3(-1, 0, 0), 0, 10)
    tree.insert_element(Vector3(-1, 0, 0), Vector3(-large, 0, 0), 1, 11)
    tree.insert_element(Vector3(-2, 2.25, 0), Vector3(-2, 2.25, 0), 2, 12)
    var got = tree.get_nearest_neighbours(Vector3(-2, 1, 0), 3)
    for i in range(3):
        assert_equal(got[i].start_value, i)
    assert_equal(
        _segment_distance2(
            Vector3(-large, 0, 0), Vector3(-1, 0, 0), Vector3(-2, 1, 0)
        ),
        Float64(1),
    )


def test_slab_axis_boundaries_and_empty_box() raises:
    var box = Box3(Vector3(0, 0, 0), Vector3(1, 1, 1))
    for axis in range(3):
        var a = Vector3(0.5, 0.5, 0.5)
        var b = a
        if axis == 0:
            a.x = -1
            b.x = 2
        elif axis == 1:
            a.y = -1
            b.y = 2
        else:
            a.z = -1
            b.z = 2
        assert_true(segment_intersects_box(a, b, box))
        assert_true(segment_intersects_box(b, a, box))
    assert_equal(
        segment_intersects_box(Vector3(0, 0, 0), Vector3(0, 0, 0), box), True
    )
    assert_equal(
        segment_intersects_box(
            Vector3(0, 0, 0), Vector3(1, 1, 1), Box3.empty()
        ),
        False,
    )


def test_infinite_outer_box_faces() raises:
    var infinity = inf[DType.float32]()
    var box = Box3(
        Vector3(-infinity, -1, -infinity), Vector3(infinity, 1, infinity)
    )
    assert_true(
        segment_intersects_box(Vector3(-2, -2, 3), Vector3(2, 2, 4), box)
    )
    assert_equal(
        segment_intersects_box(Vector3(-2, 2, 3), Vector3(2, 3, 4), box), False
    )
    assert_true(segment_intersects_box(Vector3(0, 0, 0), Vector3(0, 0, 0), box))


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
