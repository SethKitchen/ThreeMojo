"""Finite-extreme regression cases from tools/reference_segment_geometry.py.

Expected distances use exact rational projection, independently of the
production cross-product and expansion implementation. Inputs retain their
IEEE words. Relative checks do not use an absolute floor for tiny distances.
"""

from extensions.carla.rtree import (
    SegmentCloudRtree,
    SegmentElement,
    SegmentFilter,
    _box_distance2,
    _segment_distance2,
    segment_intersects_box,
)
from math.bounds import Box3
from math.vector3 import Vector3
from math.segment import _point_segment_distance2
from std.memory import bitcast
from std.math import inf
from std.testing import TestSuite, assert_equal, assert_true


def _vector(words: Array[UInt32, 3]) -> Vector3:
    return Vector3(
        bitcast[DType.float32](words[0]),
        bitcast[DType.float32](words[1]),
        bitcast[DType.float32](words[2]),
    )


@no_inline
def _distance_case(words: Array[UInt32, 9], expected: Float64) raises:
    var a = _vector([words[0], words[1], words[2]])
    var b = _vector([words[3], words[4], words[5]])
    var p = _vector([words[6], words[7], words[8]])
    var raw = _point_segment_distance2(a, b, p)
    assert_equal(raw, _point_segment_distance2(b, a, p))
    var got = _segment_distance2(a, b, p)
    assert_equal(got, _segment_distance2(b, a, p))
    if expected == 0:
        assert_equal(raw, Float64(0))
        assert_equal(got, Float64(0))
    else:
        assert_true(abs(raw - expected) <= expected * 1e-12)
        assert_true(abs(got - expected) <= expected * 1e-12)


@no_inline
def _slab_case(words: Array[UInt32, 12], expected: Bool) raises:
    var a = _vector([words[0], words[1], words[2]])
    var b = _vector([words[3], words[4], words[5]])
    var box = Box3(
        _vector([words[6], words[7], words[8]]),
        _vector([words[9], words[10], words[11]]),
    )
    assert_equal(segment_intersects_box(a, b, box), expected)
    assert_equal(segment_intersects_box(b, a, box), expected)
    var tree = SegmentCloudRtree()
    tree.insert_element(a, b, 0, 1)
    tree.insert_element(b, a, 2, 3)
    var found = tree.get_intersections(box)
    assert_equal(len(found), 2 if expected else 0)
    if expected:
        assert_equal(found[0].start_value, 0)
        assert_equal(found[1].start_value, 2)


def test_exact_distance_reference() raises:
    # exterior_gap
    _distance_case([4271273625, 0, 0, 3212836864, 0, 0, 0, 0, 0], Float64(1.0))
    # interior_near_end
    _distance_case(
        [4271273625, 0, 0, 3212836864, 0, 0, 3221225472, 1065353216, 0],
        Float64(1.0),
    )
    # interior_slanted_near_end
    _distance_case(
        [
            4271273625,
            4271273625,
            0,
            3212836864,
            3221225472,
            0,
            3221225472,
            3221225472,
            0,
        ],
        Float64(0.5),
    )
    # interior_slanted_gap
    _distance_case(
        [
            4271273625,
            4271273625,
            0,
            3212836864,
            3221225472,
            0,
            3225419776,
            3221225472,
            0,
        ],
        Float64(2.0),
    )
    # extreme_midpoint
    _distance_case(
        [4286578687, 0, 0, 2139095039, 1065353216, 0, 0, 0, 0], Float64(0.25)
    )
    # minimum_segment
    _distance_case([0, 0, 0, 1, 0, 0, 1, 1, 0], Float64(1.9636373861190906e-90))
    # minimum_gap
    _distance_case(
        [4286578687, 0, 0, 2147483649, 0, 0, 0, 0, 0],
        Float64(1.9636373861190906e-90),
    )
    # mixed_3d
