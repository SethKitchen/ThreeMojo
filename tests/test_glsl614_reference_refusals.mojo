"""Generated checks against captured Mesa GLSL ES 3.0 references.

Generated by generate_mojo_tests.py from fixtures/fixtures.json.
Unsigned expectations are compared before conversion to float color.
Refusals remain distinct from the captured full GLSL results.
"""

from materials.glsl import compile_shader_material
from tests.test_glsl import VERTEX, run
from std.testing import TestSuite, assert_equal, assert_raises


def test_reference_while_runtime_bound_63() raises:
    """Check independent fixture while_runtime_bound_63."""
    # Expected UInt32 readback: 3f0000003900003f010000013f000000
    with assert_raises(contains="must provably stop within"):
        _ = compile_shader_material(
            VERTEX,
            """
            uniform uint gain; uniform uint limit;

            void main() {
                uvec4 result = uvec4(0u);
            uint i = 0u; uint total = 4294967290u;
            while (i < limit) { i += 1u; total += gain; }
            result = uvec4(i, total, gain, limit);

                gl_FragColor = vec4(float(all(equal(result, uvec4(63u, 1056964665u, 16777217u, 63u)))));
            }
            """,
        )


