def test_reference_while_nested_16_by_16() raises:
    """Check independent fixture while_nested_16_by_16."""
    # Expected UInt32 readback: 10000000000100000000000001000000
    with assert_raises(contains="would grow the graph past"):
        _ = compile_shader_material(
            VERTEX,
            """
            void main() {
                uvec4 result = uvec4(0u);
            uint outer = 0u; uint total = 0u; while (outer < 16u) { uint inner = 0u; while (inner < 16u) { inner += 1u; total += 1u; } outer += 1u; } result = uvec4(outer,total,0u,1u);

                gl_FragColor = vec4(float(all(equal(result, uvec4(16u, 256u, 0u, 1u)))));
            }
            """,
        )


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
