        (
            [
                UInt64(0xDDC8884F757D224B),
                UInt64(0x3FFDDA9C85A0B495),
                UInt64(0xFFE0000000000000),
                UInt64(0xFFEDDA9C85A0B495),
                UInt64(0x7FF0000000000000),
                UInt64(0x800EED4E42D05A4B),
                UInt64(0x1DD8884F757D224B),
