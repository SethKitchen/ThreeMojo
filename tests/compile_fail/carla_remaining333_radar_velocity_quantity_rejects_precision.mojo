"""Reject precision input at the radar velocity quantity boundary."""

from extensions.carla.radar import RadarDetection
from units.si import (
    Duration,
    Duration64,
    Length,
    Length64,
    Angle,
    Angle64,
    Velocity,
    Velocity64,
    Area,
    Area64,
    InverseLength,
    InverseLength64,
)


def main() raises:
    _ = RadarDetection(Velocity64(1), Angle(0), Angle(0), Length(1))
