"""Reject raw input at the image angle quantity boundary."""

from extensions.carla.sensor_data import image_data
from render.framebuffer import Framebuffer, Color
from units.si import (
    Duration,
    Duration64,
    Length,
    Length64,
    Angle,
    Angle64,
    Velocity,
    Velocity64,
    Area,
    Area64,
    InverseLength,
    InverseLength64,
)


def main() raises:
    var image = Framebuffer(1, 1, Color(0, 0, 0))
    _ = image_data(image, Float32(1))
