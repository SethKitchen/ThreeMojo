"""Reject dimension input at the recorder frame time quantity boundary."""

from extensions.carla.recorder import Recorder
from units.si import (
    Duration,
    Duration64,
    Length,
    Length64,
    Angle,
    Angle64,
    Velocity,
    Velocity64,
    Area,
    Area64,
    InverseLength,
    InverseLength64,
)


def main() raises:
    var recorder = Recorder()
    recorder.write_frame(Length64(1), Duration64(0), Duration64(0))
