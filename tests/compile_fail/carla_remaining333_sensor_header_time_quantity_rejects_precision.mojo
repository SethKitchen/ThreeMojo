"""Reject precision input at the sensor header time quantity boundary."""

from extensions.carla.sensor_data import sensor_header, RGB_CAMERA
from tests.test_carla_world import _pose
from units.si import (
    Duration,
    Duration64,
    Length,
    Length64,
    Angle,
    Angle64,
    Velocity,
    Velocity64,
    Area,
    Area64,
    InverseLength,
    InverseLength64,
)


def main() raises:
    _ = sensor_header(RGB_CAMERA, 0, Duration(1), _pose(0, 0, 0, 0))
