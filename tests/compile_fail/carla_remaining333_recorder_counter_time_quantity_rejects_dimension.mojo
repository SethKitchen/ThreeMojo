"""Reject dimension input at the recorder counter time quantity boundary."""

from extensions.carla.recorder_packets import RecorderFrames
from units.si import (
    Duration,
    Duration64,
    Length,
    Length64,
    Angle,
    Angle64,
    Velocity,
    Velocity64,
    Area,
    Area64,
    InverseLength,
    InverseLength64,
)


def main() raises:
    var frames = RecorderFrames()
    frames.set_frame(Length64(1))
