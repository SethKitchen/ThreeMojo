"""Reject dimension assignment of the typed point distance squared result."""

from extensions.carla.traffic_manager_map import distance_squared
from math.vector3 import Vector3
from units.si import (
    Duration,
    Duration64,
    Length,
    Length64,
    Angle,
    Angle64,
    Velocity,
    Velocity64,
    Area,
    Area64,
    InverseLength,
    InverseLength64,
)


def main() raises:
    var result: Length = distance_squared(Vector3(0, 0, 0), Vector3(1, 2, 3))
    _ = result
