    for path in files:
        var copied = run_program(["cp", path, root + "/" + path], 10.0)
        if copied.status != 0:
            raise Error(copied.output)


def test_the_live_dependencies_hold() raises:
    """The 497 dependencies keep their reviewed digests."""
    typed_boundary_dependencies(".")
    typed_boundary_dependencies("./")
    typed_boundary_dependencies("animation/..")


def test_a_changed_animation_package_is_refused() raises:
    """A changed animation package is refused."""
    var root = "/tmp/typed-boundary-dependencies-animation"
    _copy(root)
    var path = root + "/animation/__init__.mojo"
    Path(path).write_text(Path(path).read_text() + "\n")
    with assert_raises(
        contains=(
            "typed boundary bound input changed: " + "animation/__init__.mojo"
        )
    ):
        typed_boundary_dependencies(root)


def test_a_changed_temperature_unit_is_refused() raises:
    """A changed temperature unit is refused."""
    var root = "/tmp/typed-boundary-dependencies-temperature"
    _copy(root)
    var path = root + "/units/temperature.mojo"
    Path(path).write_text(Path(path).read_text() + "\n")
    with assert_raises(
        contains=(
            "typed boundary bound input changed: " + "units/temperature.mojo"
        )
    ):
        typed_boundary_dependencies(root)


def main() raises:
    """Run the typed-boundary dependency tests."""
    TestSuite.discover_tests[__functions_in_module()]().run()
