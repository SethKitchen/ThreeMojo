"""The typed-boundary current dependencies keep their reviewed digests."""

from std.pathlib import Path
from std.testing import TestSuite, assert_raises

from tools._process import run_program
from tools.typed_boundary_dependencies import typed_boundary_dependencies


def _copy(root: String) raises:
    """Copy the reviewed dependencies.

    Args:
        root: The temporary repository.

    Raises:
        Error: A file cannot be copied.
    """
    var cleared = run_program(["rm", "-rf", root], 10.0)
    if cleared.status != 0:
        raise Error(cleared.output)
    var made = run_program(
        [
            "mkdir",
            "-p",
            root + "/animation",
            root + "/cameras",
            root + "/core",
            root + "/exporters",
            root + "/extensions/carla/physics",
            root + "/extensions/physics",
            root + "/geometries",
            root + "/lights",
            root + "/loaders",
            root + "/materials",
            root + "/math",
            root + "/objects",
            root + "/postprocessing",
            root + "/render",
            root + "/renderers",
            root + "/tests/compile_fail",
            root + "/units",
        ],
        10.0,
    )
    if made.status != 0:
        raise Error(made.output)
    var files = List[String]()
    files.append("animation/__init__.mojo")
    files.append("cameras/__init__.mojo")
    files.append("core/__init__.mojo")
    files.append("core/assets.mojo")
    files.append("core/layers.mojo")
    files.append("exporters/__init__.mojo")
    files.append("extensions/__init__.mojo")
    files.append("extensions/carla/__init__.mojo")
    files.append("extensions/carla/actor.mojo")
    files.append("extensions/carla/agents_behavior.mojo")
    files.append("extensions/carla/agents_controller.mojo")
    files.append("extensions/carla/agents_local_planner.mojo")
    files.append("extensions/carla/agents_misc.mojo")
    files.append("extensions/carla/blueprint.mojo")
    files.append("extensions/carla/bounding_box.mojo")
    files.append("extensions/carla/camera_render.mojo")
    files.append("extensions/carla/capture.mojo")
    files.append("extensions/carla/collision.mojo")
