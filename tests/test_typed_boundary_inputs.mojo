    # Copied in this process: one `cp` for each file took most of the
    # five seconds a test may run.
    for path in files:
        Path(root + "/" + path).write_bytes(Path(path).read_bytes())


def test_the_live_new_inputs_hold() raises:
    """The 232 new inputs keep their reviewed digests."""
    typed_boundary_inputs(".")
    typed_boundary_inputs("./")
    typed_boundary_inputs("extensions/..")


def test_a_changed_quantity_boundary_is_refused() raises:
    """A changed quantity boundary is refused."""
    var root = "/tmp/typed-boundary-inputs-quantity"
    _copy(root)
    var path = root + "/extensions/carla/quantity_boundary.mojo"
    Path(path).write_text(Path(path).read_text() + "\n")
    with assert_raises(
        contains=(
            "typed boundary bound input changed: "
            + "extensions/carla/quantity_boundary.mojo"
        )
    ):
        typed_boundary_inputs(root)


def test_a_changed_traffic_boundary_is_refused() raises:
    """A changed traffic-actor boundary test is refused."""
    var root = "/tmp/typed-boundary-inputs-traffic"
    _copy(root)
    var path = root + "/tests/test_carla_traffic_actor_boundaries.mojo"
    Path(path).write_text(Path(path).read_text() + "\n")
    with assert_raises(
        contains=(
            "typed boundary bound input changed: "
            + "tests/test_carla_traffic_actor_boundaries.mojo"
        )
    ):
        typed_boundary_inputs(root)


def main() raises:
    """Run the typed-boundary new-input tests."""
    TestSuite.discover_tests[__functions_in_module()]().run()
