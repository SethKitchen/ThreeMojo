"""The typed-boundary new inputs keep their reviewed digests."""

from std.pathlib import Path
from std.testing import TestSuite, assert_raises

from tools._process import run_program
from tools.typed_boundary_inputs import typed_boundary_inputs


def _copy(root: String) raises:
    """Copy the reviewed new inputs.

    Args:
        root: The temporary repository.

    Raises:
        Error: A file cannot be copied.
    """
    var cleared = run_program(["rm", "-rf", root], 10.0)
    if cleared.status != 0:
        raise Error(cleared.output)
    var made = run_program(
        [
            "mkdir",
            "-p",
            root + "/extensions/carla",
            root + "/tests/compile_fail",
        ],
        10.0,
    )
    if made.status != 0:
        raise Error(made.output)
    var files = List[String]()

    files.append("extensions/carla/quantity_boundary.mojo")
    files.append(
        "tests/compile_fail/carla_config_dvs_refractory_rejects_dimension.mojo"
    )
    files.append(
