"""Tests for `extensions.scan.scene`, the splat models of a scan.

Each model reads back from its SOG name. The PLY comments are read as
splat-transform 3.10.1 reads them: Brush's `SplatRenderMode` and
Postshot's `antialiased`, any case, the last one winning.
"""

from extensions.scan.scene import (
    SPLAT_2DGS,
    SPLAT_ANTIALIASED,
    SPLAT_DEFAULT,
    SplatModel,
    splat_model,
    splat_model_from_comments,
)
from std.testing import (
    TestSuite,
    assert_equal,
    assert_false,
    assert_raises,
    assert_true,
)


def test_the_models_have_their_names() raises:
    """Each model reads back from its name, and no other name is one."""
    assert_equal(SPLAT_DEFAULT.name(), "default")
    assert_equal(SPLAT_ANTIALIASED.name(), "antialiased")
    assert_equal(SPLAT_2DGS.name(), "2dgs")
    assert_equal(SplatModel(3).name(), "unknown")
    assert_false(SplatModel(-1).is_valid())
    assert_true(splat_model("default") == SPLAT_DEFAULT)
    assert_true(splat_model("antialiased") == SPLAT_ANTIALIASED)
    assert_true(splat_model("2dgs") == SPLAT_2DGS)
    with assert_raises(contains="unknown splat model 'mip'"):
        _ = splat_model("mip")


def test_no_comment_names_the_default() raises:
    """Comments that name no model leave the default."""
    assert_true(splat_model_from_comments(List[String]()) == SPLAT_DEFAULT)
    var other: List[String] = [
        "Generated by splat-transform 3.10.1",
        "SplatRenderMode: sketch",
        "antialiased 2",
    ]
    assert_true(splat_model_from_comments(other) == SPLAT_DEFAULT)


def test_brush_comments_name_each_model() raises:
    """`SplatRenderMode` names each model, in any case and spacing."""
    var mip: List[String] = [" SplatRenderMode: mip "]
    assert_true(splat_model_from_comments(mip) == SPLAT_ANTIALIASED)
    var flat: List[String] = ["splatrendermode:  2DGS"]
    assert_true(splat_model_from_comments(flat) == SPLAT_2DGS)
    var back: List[String] = [
        "SplatRenderMode: 2dgs",
        "SplatRenderMode: default",
    ]
    assert_true(splat_model_from_comments(back) == SPLAT_DEFAULT)


def test_short_and_blank_comments_name_nothing() raises:
    """An empty, a blank or a short comment leaves the model as it is."""
    var blank: List[String] = ["SplatRenderMode: mip", "", "   ", "x"]
    assert_true(splat_model_from_comments(blank) == SPLAT_ANTIALIASED)
    var spaced: List[String] = ["antialiased  1"]
    assert_true(splat_model_from_comments(spaced) == SPLAT_ANTIALIASED)


def test_postshot_comments_name_antialiasing() raises:
    """`antialiased 1` and `antialiased 0` set and clear it, the last one
    winning."""
    var on: List[String] = ["Antialiased 1"]
    assert_true(splat_model_from_comments(on) == SPLAT_ANTIALIASED)
    var off: List[String] = ["SplatRenderMode: mip", "antialiased 0"]
    assert_true(splat_model_from_comments(off) == SPLAT_DEFAULT)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
