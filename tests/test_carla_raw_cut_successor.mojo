            UInt64(8493788897220755456),
            UInt64(8732479677471391745),
            UInt64(8732479677471391744),
            UInt64(8732479677471391746),
        ),
        (
            UInt64(8565846491258683392),
            UInt64(8804537271509319681),
            UInt64(8804537271509319680),
            UInt64(8804537271509319682),
        ),
        (
            UInt64(8642407684923981824),
            UInt64(8885602064801988608),
            UInt64(8885602064801988607),
            UInt64(8885602064801988608),
        ),
        (
            UInt64(8709961679334539264),
            UInt64(8948652459585175553),
            UInt64(8948652459585175552),
            UInt64(8948652459585175554),
        ),
        (
            UInt64(8782019273372467200),
            UInt64(9025213653250473984),
            UInt64(9025213653250473983),
            UInt64(9025213653250473984),
        ),
        (
            UInt64(8849573267783024640),
            UInt64(9088264048033660930),
            UInt64(9088264048033660929),
            UInt64(9088264048033660930),
        ),
        (
            UInt64(8926134461448323072),
            UInt64(9164825241698959361),
            UInt64(9164825241698959360),
            UInt64(9164825241698959362),
        ),
        (
            UInt64(9074753249151549440),
            UInt64(8836062468900913153),
            UInt64(8836062468900913152),
            UInt64(9074753249151549441),
        ),
    ]:
        var origin = bitcast[DType.float64](fixture[0])
        var length = bitcast[DType.float64](fixture[1])
        var local = bitcast[DType.float64](fixture[2])
        var old = _reference_sample_dispatch_cut(origin, length, local)
        var new = _sample_dispatch_cut(origin, length, local)
        assert_equal(Bool(new), fixture[3] != 0)
        assert_equal(Bool(new), Bool(old))
        if new:
            assert_equal(bitcast[DType.uint64](new.value()), fixture[3])
            assert_equal(bitcast[DType.uint64](old.value()), fixture[3])
            assert_true(
                _sample_dispatch_predicate(origin, length, local, new.value())
            )
            assert_false(
                _sample_dispatch_predicate(
                    origin,
                    length,
                    local,
                    bitcast[DType.float64](fixture[3] - UInt64(1)),
                )
            )


def test_unsorted_live_sample_lists_preserve_refusal_and_debit() raises:
    # Enumerate every permutation of a real four-element sample list.
    # These are ordinary stored input values, with no forged list headers,
    # injected cut results, local-state mutation, or weakened validation.
    for a in range(4):
        for b in range(4):
            if a == b:
                continue
            for c in range(4):
                if c == a or c == b:
                    continue
                for d in range(4):
                    if d == a or d == b or d == c:
                        continue
                    var road = _dispatch_road(0.5)
                    road.info.geometries[0].geometry.samples[0].s = Float64(a)
                    road.info.geometries[0].geometry.samples[1].s = Float64(b)
                    road.info.geometries[0].geometry.samples[2].s = Float64(c)
                    road.info.geometries[0].geometry.samples[3].s = Float64(d)
                    for low in [Float64(0.6), 1.4, 1.5, 1.6, 2.4, 2.5, 2.6]:
                        for high in [
                            Float64(1.4),
                            1.5,
                            1.6,
                            2.4,
                            2.5,
                            2.6,
                            3.4,
                        ]:
                            if high < low:
                                continue
                            var old_nodes = 0
                            var new_nodes = 0
                            var old_terms = 0
                            var new_terms = 0
                            var old = _reference_sample_dispatch_cuts(
                                road,
                                low,
                                high,
                                old_nodes,
                                old_terms,
                                100,
                                10000,
                            )
                            var new = _try_sample_dispatch_cuts(
                                road,
                                low,
                                high,
                                new_nodes,
                                new_terms,
                                100,
                                10000,
                            )
                            assert_equal(Bool(old), Bool(new))
                            assert_equal(old_nodes, new_nodes)
                            assert_equal(old_terms, new_terms)
                            if new:
                                assert_equal(old.value()[0], new.value()[0])
                                assert_equal(old.value()[1], new.value()[1])
                                assert_equal(old.value()[2], new.value()[2])


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
