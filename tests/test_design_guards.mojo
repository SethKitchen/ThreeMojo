"""Tests that each input guard of `extensions.design` refuses every way an
input can be out of range: infinite, negative, or past a limit.

The checks of the other `test_design_*` suites test the in-range values.
These tests test the edges of each guard, one condition at a time.
"""

from std.math import inf
from std.testing import TestSuite, assert_equal, assert_raises, assert_true
from core.assets import Assets
from core.scene import Scene
from extensions.design.assembly import (
    Assembly,
    NO_RATIO,
    Part,
    add_assembly,
    draw_ratio_legend,
)
from extensions.design.beams import continuous_beam
from extensions.design.concrete import (
    one_way_shear_strength,
    propped_wall_effects,
    square_footing_side,
    strip_footing_width,
    two_way_shear_stress,
)
from extensions.design.latex import (
    TexValues,
    feet_inches,
    fixed,
    group_thousands,
)
from extensions.design.kinds import EXPOSURE_C
from extensions.design.quantities import POUND64, PSI
from extensions.design.steel import flexural_strength, w_shape
from extensions.design.tikz import TikzBody
from extensions.design.wind import elevation_factor, exposure_coefficient
from extensions.design.wood import (
    bearing_stress_ratio,
    bolt_lateral_value,
    dowel_bearing_strength,
    simple_span_check,
    southern_pine_no2,
)
from extensions.geotech.quantities import KSI, PLF, UnitWeight64
from math.vector3 import Vector3
from render.framebuffer import Color, Framebuffer
from units.si import (
    Angle64,
    Area64,
    METER,
    SecondMomentOfArea64,
    DEGREE64,
    FOOT64,
    Force64,
    INCH64,
    Length,
    Length64,
    LineLoad64,
    Pressure64,
)


def _inf() -> Float64:
    return inf[DType.float64]()


def test_macro_names_refuse_each_character_range() raises:
    var v = TexValues("guards")
    # Below "A", between "Z" and "a", and above "z".
    for bad in ["A@", "A[", "a{"]:
        with assert_raises(contains="ASCII letters"):
            v.add_text(bad, "x")
    v.add_text("Az", "ok")
    assert_equal(v.count(), 1)
    # An empty set renders only its comment line.
    assert_equal(
        TexValues("empty").render(), "% Auto-generated by empty. Do not edit.\n"
    )


def test_digit_runs_stop_at_any_non_digit() raises:
    assert_equal(group_thousands("1234.5"), "1{,}234.5")
    assert_equal(group_thousands("1234a"), "1{,}234a")
    assert_equal(group_thousands("1234 "), "1{,}234 ")


def test_number_guards() raises:
    with assert_raises(contains="0 to 10"):
        _ = fixed(1, -1)
    with assert_raises(contains="finite"):
        _ = fixed(-_inf(), 1)
    with assert_raises(contains="finite"):
        _ = feet_inches(Length64(_inf()), 2)


def test_flexure_guards() raises:
    var s = w_shape("W8x18")
    var fy = Pressure64(50, KSI)
    with assert_raises(contains="unbraced length"):
        _ = flexural_strength(s, fy, Length64(_inf()), 1)
    with assert_raises(contains="Cb must"):
        _ = flexural_strength(s, fy, Length64(0), _inf())


def test_drawing_guards() raises:
    var b = TikzBody("guards")
    with assert_raises(contains="finite"):
        b.line("x", -_inf(), 0, 0, 0)
    with assert_raises(contains="two points"):
        b.polyline("x", [0.0, 1.0], [0.0, 1.0, 2.0])
    assert_equal(
        TikzBody("empty").render(), "% Auto-generated by empty. Do not edit.\n"
    )


def test_wind_guards() raises:
    with assert_raises(contains="gradient height"):
        _ = exposure_coefficient(Length64(-1, FOOT64), EXPOSURE_C)
    with assert_raises(contains="ground elevation"):
        _ = elevation_factor(Length64(-_inf()))


def test_wood_load_guards() raises:
    var lumber = southern_pine_no2(10)
    var w = LineLoad64(50, PLF)
    var b = Length64(1.5, INCH64)
    var d = Length64(9.25, INCH64)
    var l = Length64(10, FOOT64)
    var bad: List[Tuple[LineLoad64, LineLoad64]] = [
        (w, -w),
        (LineLoad64(_inf()), w),
        (w, LineLoad64(_inf())),
    ]
    for pair in bad:
        with assert_raises(contains="loads"):
            _ = simple_span_check(
                lumber, b, d, 1, l, pair[0], pair[1], 1, True, 360, 240
            )
    with assert_raises(contains="reaction"):
        _ = bearing_stress_ratio(lumber, Force64(_inf()), b, b)


def test_dowel_and_bolt_guards() raises:
    var d = Length64(0.625, INCH64)
    var a0 = Angle64(0, DEGREE64)
    with assert_raises(contains="specific gravity"):
        _ = dowel_bearing_strength(0, d, a0)
    with assert_raises(contains="1/4 in"):
        _ = dowel_bearing_strength(0.5, Length64(_inf()), a0)
    with assert_raises(contains="grain angle"):
        _ = dowel_bearing_strength(0.5, d, Angle64(-1, DEGREE64))
    var f = Pressure64(1000, PSI)
    var six = Length64(6, INCH64)
    var side = Length64(1.5, INCH64)
    with assert_raises(contains="bolt diameter"):
        _ = bolt_lateral_value(Length64(_inf()), six, side, f, f, f, a0)
    with assert_raises(contains="grain angle"):
        _ = bolt_lateral_value(d, six, side, f, f, f, Angle64(91, DEGREE64))
    var z = bolt_lateral_value(d, six, side, f, f, f, Angle64(90, DEGREE64))
    assert_true(z.lateral.to(POUND64) > 0)


def test_assembly_guards() raises:
    var gray = Color(9, 9, 9)
    var a = Assembly()
    with assert_raises(contains="opacity"):
        a.add(
            Part(
                "glow",
                Vector3(0, 0, 0),
                Vector3(1, 1, 1),
                gray,
                0,
                NO_RATIO,
                0,
                1.5,
            )
        )
    var scene = Scene()
    var assets = Assets()
    # An empty assembly adds nothing.
    assert_equal(add_assembly(scene, assets, a, 1, False, Length(0)), 0)
    with assert_raises(contains="build state"):
        _ = add_assembly(scene, assets, a, _inf(), False, Length(0))
    with assert_raises(contains="drop height"):
        _ = add_assembly(
            scene, assets, a, 1, False, Length(inf[DType.float32]())
        )
    var frame = Framebuffer(20, 10, Color(0, 0, 0))
    with assert_raises(contains="2 by 2"):
        draw_ratio_legend(frame, 0, 0, 5, 1)
    with assert_raises(contains="fit inside"):
        draw_ratio_legend(frame, -1, 0, 5, 5)
    with assert_raises(contains="fit inside"):
        draw_ratio_legend(frame, 0, -1, 5, 5)
    with assert_raises(contains="fit inside"):
        draw_ratio_legend(frame, 0, 8, 5, 5)


def test_beam_load_guard() raises:
    var spans: List[Length64] = [Length64(10, FOOT64)]
    var loads: List[LineLoad64] = [LineLoad64(-_inf())]
    with assert_raises(contains="finite"):
        _ = continuous_beam(
            spans, loads, Pressure64(29000, KSI), SecondMomentOfArea64(1)
        )


def test_concrete_guards() raises:
    var span = Length64(8, FOOT64)
    var g = UnitWeight64(1)
    var q = Pressure64(0)
    with assert_raises(contains="soil height"):
        _ = propped_wall_effects(span, Length64(_inf()), g, q)
    with assert_raises(contains="fluid pressure"):
        _ = propped_wall_effects(span, span, UnitWeight64(_inf()), q)
    with assert_raises(contains="surcharge"):
        _ = propped_wall_effects(span, span, g, Pressure64(_inf()))
    var fc = Pressure64(3000, PSI)
    var b = Length64(12, INCH64)
    with assert_raises(contains="steel area"):
        _ = one_way_shear_strength(b, b, Area64(_inf()), fc)
    with assert_raises(contains="beta"):
        _ = two_way_shear_stress(b, b, _inf(), 40, fc)
    var qa = Pressure64(1500, PSI)
    with assert_raises(contains="footing load"):
        _ = square_footing_side(Force64(_inf()), qa, Pressure64(0))
    with assert_raises(contains="under the allowable"):
        _ = square_footing_side(Force64(1), qa, Pressure64(-1))
    with assert_raises(contains="footing load"):
        _ = strip_footing_width(LineLoad64(_inf()), qa, Pressure64(0))
    with assert_raises(contains="under the allowable"):
        _ = strip_footing_width(LineLoad64(1), qa, qa)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
