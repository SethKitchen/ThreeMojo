"""Generated checks against captured Mesa GLSL ES 3.0 references.

Generated by generate_mojo_tests.py from fixtures/fixtures.json.
Unsigned expectations are compared before conversion to float color.
Captured expectations are independent of the node interpreter.
"""

from materials.glsl import compile_shader_material
from tests.test_glsl import VERTEX, run
from std.testing import TestSuite, assert_equal, assert_raises

from materials.nodes import (
    AT_FRAGMENT,
    AT_RIGHT,
    AT_UP,
    COLOR_NODE,
    NodeContext,
    NodeInputs,
    NodeProgram,
    NodeSource,
    run_nodes,
)
from math.vector3 import Vector3
from render.framebuffer import FloatColor

comptime Lanes = SIMD[DType.float32, 4]


struct FixtureSource(NodeSource):
    """Read program words and use the independent fixture's pixel center."""

    var code: List[Float32]

    def __init__(out self, program: NodeProgram):
        """Copy the program's encoded words."""
        self.code = program.code.copy()

    def word(self, at: Int) -> Float32:
        """Read one program word without a numeric conversion."""
        return self.code[at]

    def sample(self, slot: Int, u: Float32, v: Float32) -> FloatColor:
        """Return white; the integer fixtures do not sample textures."""
        return FloatColor(1, 1, 1, 1)

    def sample_level(
        self, slot: Int, u: Float32, v: Float32, level: Float32
    ) -> FloatColor:
        """Return white; the integer fixtures do not sample textures."""
        return FloatColor(1, 1, 1, 1)

    def fetch(self, slot: Int, x: Int, y: Int, level: Int) -> FloatColor:
        """Return white; the integer fixtures do not fetch textures."""
        return FloatColor(1, 1, 1, 1)

    def size(self, slot: Int, level: Int) -> Lanes:
        """Return a one-pixel size for the unused texture interface."""
        return Lanes(1, 1, 0, 0)

    def shares(self, context: NodeContext) -> Lanes:
        """Select one corner for the unused interpolated attributes."""
        return Lanes(1, 0, 0, 0)

    def frag_coord(self, context: NodeContext) -> Lanes:
        """Match the independent 1-by-1 GLES framebuffer center."""
        if context == AT_RIGHT:
            return Lanes(1.5, 0.5, 0, 1)
        if context == AT_UP:
            return Lanes(0.5, 1.5, 0, 1)
        return Lanes(0.5, 0.5, 0, 1)

    def corner(self, context: NodeContext) -> NodeInputs:
        """Return valid attributes that these integer fixtures do not read."""
        return NodeInputs(
            0,
            0,
            Vector3(0, 0, 0),
            Vector3(0, 0, 1),
            Vector3(1, 1, 1),
            Vector3(0, 0, 0),
            False,
        )


def fixture_run(program: NodeProgram) -> Lanes:
    """Evaluate one integer fixture at the reference pixel center."""
    var source = FixtureSource(program)
    return run_nodes(source, COLOR_NODE, source.corner(AT_FRAGMENT))


def test_reference_uint_literal_boundaries() raises:
    """Check independent fixture uint_literal_boundaries."""
    # Expected UInt32 readback: ffffff000000000101000001ffffffff
    var program = compile_shader_material(
        VERTEX,
        """
        void main() {
            uvec4 result = uvec4(0u);
        result = uvec4(16777215u, 16777216u, 16777217u, 4294967295u);

            gl_FragColor = vec4(float(all(equal(result, uvec4(16777215u, 16777216u, 16777217u, 4294967295u)))));
        }
        """,
    )
    assert_equal(run(program)[0], Float32(1))


