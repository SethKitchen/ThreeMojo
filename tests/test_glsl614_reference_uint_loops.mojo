def test_reference_while_break_continue() raises:
    """Check independent fixture while_break_continue."""
    # Expected UInt32 readback: 41000000000400004100000001000000
    var program = compile_shader_material(
        VERTEX,
        """
        bool condition(uint i, inout uint calls) { calls += 1u; return i < 256u; }

        void main() {
            uvec4 result = uvec4(0u);
        uint i = 0u; uint total = 0u; uint calls = 0u;
        while (condition(i,calls)) { i += 1u; if (i == 65u) { break; } if ((i % 2u) == 0u) { continue; } total += i; }result = uvec4(i,total,calls,1u);

            gl_FragColor = vec4(float(all(equal(result, uvec4(65u, 1024u, 65u, 1u)))));
        }
        """,
    )
    assert_equal(run(program)[0], Float32(1))


