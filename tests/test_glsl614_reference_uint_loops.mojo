def test_reference_uint_scalar_equal_order() raises:
    """Check independent fixture uint_scalar_equal_order."""
    # Expected UInt32 readback: 00000000010000000000000000000000
    var program = compile_shader_material(
        VERTEX,
        """
        uniform uint uA; uniform uint uB; uniform uvec4 uV; uniform uvec4 uW; uniform bool uFlag; uniform int uIndex;

        void main() {
            uvec4 result = uvec4(0u);
        result = uvec4(uint(uA <= uB), uint(uA >= uB), uint(uB == 16777216u), uint(uA != uA));

            gl_FragColor = vec4(float(all(equal(result, uvec4(0u, 1u, 0u, 0u)))));
        }
        """,
    )
    program.set_uniform_uint("uA", UInt32(4294967295))
    program.set_uniform_uint("uB", UInt32(16777217))
    assert_equal(run(program)[0], Float32(1))


