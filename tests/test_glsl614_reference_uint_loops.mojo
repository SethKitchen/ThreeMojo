def test_reference_uint_const_minmaxclamp() raises:
    """Check independent fixture uint_const_minmaxclamp."""
    # Expected UInt32 readback: 01000001000000800100008000000080
    var program = compile_shader_material(
        VERTEX,
        """
        void main() {
            uvec4 result = uvec4(0u);
        result = uvec4(min(4294967295u, 16777217u), max(2147483647u, 2147483648u), clamp(4294967295u, 16777216u, 2147483649u), clamp(16777217u, 2147483648u, 4294967295u));

