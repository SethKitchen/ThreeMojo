"""The PR760 registry inputs keep their reviewed digests."""

from std.pathlib import Path
from std.testing import TestSuite, assert_raises

from tools._process import run_program
from tools.pr760_registry_inputs import pr760_registry_inputs


def _copy(root: String) raises:
    """Copy the reviewed registry inputs.

    Args:
        root: The temporary repository.

    Raises:
        Error: A file cannot be copied.
    """
    var cleared = run_program(["rm", "-rf", root], 10.0)
    if cleared.status != 0:
        raise Error(cleared.output)
    var made = run_program(
        [
            "mkdir",
            "-p",
            root + "/animation",
            root + "/cameras",
            root + "/core",
            root + "/examples",
            root + "/exporters",
            root + "/extensions/humanoid/skeleton/head/hair",
            root + "/extensions/physics",
            root + "/generators",
            root + "/geometries",
            root + "/lights",
            root + "/loaders",
            root + "/materials",
            root + "/math",
            root + "/objects",
            root + "/postprocessing",
            root + "/render",
            root + "/renderers",
            root + "/tests",
            root + "/tools",
            root + "/units",
        ],
        10.0,
    )
    if made.status != 0:
        raise Error(made.output)
    var files = List[String]()
    files.append("animation/animation_clip.mojo")
    files.append("animation/keyframe_track.mojo")
    files.append("cameras/array_camera.mojo")
    files.append("cameras/camera.mojo")
    files.append("cameras/cube_camera.mojo")
    files.append("cameras/orthographic_camera.mojo")
    files.append("cameras/perspective_camera.mojo")
    files.append("core/__init__.mojo")
    files.append("core/assets.mojo")
    files.append("core/background.mojo")
    files.append("core/binary.mojo")
    files.append("core/buffer_attribute.mojo")
    files.append("core/buffer_geometry.mojo")
    files.append("core/interleaved_buffer.mojo")
    files.append("core/layers.mojo")
    files.append("core/object3d.mojo")
    files.append("core/order.mojo")
    files.append("core/ordinal.mojo")
