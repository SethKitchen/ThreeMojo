    # five seconds a test may run.
    for path in files:
        Path(root + "/" + path).write_bytes(Path(path).read_bytes())


def test_the_live_registry_inputs_hold() raises:
    """The 392 registry inputs keep their reviewed digests."""
    pr760_registry_inputs(".")
    pr760_registry_inputs("./")
    pr760_registry_inputs("animation/..")


def test_a_changed_animation_clip_is_refused() raises:
    """A changed animation clip is refused."""
    var root = "/tmp/pr760-registry-animation"
    _copy(root)
    var path = root + "/animation/animation_clip.mojo"
    Path(path).write_text(Path(path).read_text() + "\n")
    with assert_raises(
        contains=(
            "registry candidate input changed: animation/animation_clip.mojo"
        )
    ):
        pr760_registry_inputs(root)


def test_a_changed_last_registry_input_is_refused() raises:
    """A changed last registry input is refused."""
    var root = "/tmp/pr760-registry-last"
    _copy(root)
    var path = root + "/units/si.mojo"
    Path(path).write_text(Path(path).read_text() + "\n")
    with assert_raises(
        contains=("registry candidate input changed: " + "units/si.mojo")
    ):
        pr760_registry_inputs(root)


def main() raises:
    """Run the PR760 registry-input tests."""
    TestSuite.discover_tests[__functions_in_module()]().run()
