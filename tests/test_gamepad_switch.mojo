"""Tests for `extensions.gamepad.hid_switch`, the Switch Pro driver.

Each script runs on the scripted device of `tests._gamepad_hid_script`.
The expected transcripts are what SDL 3.2.24's own driver printed for the
same scripts, through the oracle that the script runner describes.

The oracle's clock moves only on `time` lines, and SDL waits for a reply
until the clock moves 100 ms. So each script queues every reply that SDL
waits for. A report of no bytes, `input 0`, stops SDL's loops that read
all the waiting reports: one when SDL starts, one when it opens the pad,
and one more for a pad that sent no report. The two `timeout` tests ran
on a copy of the oracle whose `SDL_Delay` moves the clock, so that a reply
that never comes times out.

The driver's clock moves on `update`, so the scripts read the device
after each time step before they rumble.

The runner prints one line where the oracle prints two for a removed pad,
`removed` for the joystick and for the gamepad, and it prints a negative
zero as `0.0000`. `_oracle` makes the same changes to the oracle's text.
"""

from std.testing import TestSuite, assert_equal, assert_false, assert_true
from extensions.gamepad.gamepad import Gamepad
from extensions.gamepad.guid import ProductId, VendorId, joystick_guid_info
from extensions.gamepad.hid import (
    HID_BUS_BLUETOOTH,
    HID_BUS_USB,
    HidDeviceInfo,
    HidSource,
)
from extensions.gamepad.hid_device import HidapiDevice
from extensions.gamepad.hid_switch import (
    SwitchDriver,
    encode_rumble_high_amplitude,
    encode_rumble_low_amplitude,
)
from extensions.gamepad.ids import (
    GAMEPAD_TYPE_NINTENDO_SWITCH_PRO,
    GAMEPAD_TYPE_STANDARD,
)
from extensions.gamepad.joystick import Joystick
from tests._gamepad_hid_script import (
    ScriptedHid,
    bytes_hex,
    hex_bytes,
    run_script,
)
from units.si import Duration64


def _oracle(text: String) -> String:
    """Write the oracle's transcript as the runner prints it.

    Args:
        text: The oracle's transcript.

    Returns:
        The transcript with one `removed` line for each removal and no
        negative zeros.
    """
    return text.replace("removed\nremoved\n", "removed\n").replace(
        " -0.0000", " 0.0000"
    )


