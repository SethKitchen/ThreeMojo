def _device(
    vendor: Int, product: Int, bluetooth: Bool, serial: String = ""
) raises -> HidapiDevice:
    """Describe a device as enumeration would.

    Args:
        vendor: The USB vendor id.
        product: The USB product id.
        bluetooth: Whether it is on Bluetooth.
        serial: The serial number.

    Returns:
        The device.

    Raises:
        Error: If the GUID cannot be made.
    """
    return HidapiDevice(
        HidDeviceInfo(
            "/dev/hidraw0",
            VendorId(vendor),
            ProductId(product),
            0x100,
            serial,
            "PDP",
            "Pad",
            1,
            5,
            -1 if bluetooth else 0,
            HID_BUS_BLUETOOTH if bluetooth else HID_BUS_USB,
        )
    )


def _queue(mut source: ScriptedHid, lines: List[String]):
    """Queue reports written as hexadecimal pairs.

    Args:
        source: The device.
        lines: The reports.
    """
    for line in lines:
        source.queue.append(hex_bytes(line))


def _status(device_type: Int) -> String:
    """Return a USB status reply.

    Args:
        device_type: What the pad says it is.

    Returns:
        The report as hexadecimal pairs.
    """
    return "810100" + String(bytes_hex([UInt8(device_type)])) + "665544332211"


def _device_info(device_type: Int) -> String:
    """Return a Bluetooth device information reply.

    Args:
        device_type: What the pad says it is.

    Returns:
        The report as hexadecimal pairs.
    """
    return (
        "210000000000000000000000008002"
        + "0390"
        + String(bytes_hex([UInt8(device_type)]))
        + "00112233445566"
    )


def test_is_supported() raises:
    """The driver takes the Switch Pro type, except the devices that
    other SDL drivers run.
    """
    var pro = GAMEPAD_TYPE_NINTENDO_SWITCH_PRO
    var nintendo = VendorId(0x057E)
    assert_true(
        SwitchDriver.is_supported(
            "Pro Controller", pro, nintendo, ProductId(0x2009), 0, -1
        )
    )
    assert_false(
        SwitchDriver.is_supported(
            "HORI Wireless Switch Pad", pro, VendorId(0x0F0D),
            ProductId(0x00F6), 0, 0,
        )
    )  # fmt: skip
    for product in [0x2006, 0x2007, 0x200E, 0x2017, 0x2019, 0x201E]:
        assert_false(
            SwitchDriver.is_supported(
                "Pad", pro, nintendo, ProductId(product), 0, -1
            )
        )
    # Another vendor's product id with the same number is not excluded.
    assert_true(
        SwitchDriver.is_supported(
            "Pad", pro, VendorId(0x0E6F), ProductId(0x2006), 0, -1
        )
    )
    assert_false(
        SwitchDriver.is_supported(
            "Pad", GAMEPAD_TYPE_STANDARD, nintendo, ProductId(0x2009), 0, -1
        )
    )


def test_kinvoca_joycon_is_refused() raises:
    """A pad with the Pro Controller's ids that says it is a Joy-Con is
    left to SDL's Joy-Con driver, which is not ported.
    """
    var usb = _device(0x057E, 0x2009, False)
    var source = ScriptedHid()
    _queue(source, [_status(1)])
    assert_false(SwitchDriver.is_supported_device(source, usb))
    var bluetooth = _device(0x057E, 0x2009, True)
    source = ScriptedHid()
    _queue(source, [_device_info(3), _device_info(2)])
    assert_false(SwitchDriver.is_supported_device(source, bluetooth))
    # Another vendor's pad is not asked.
    var third = _device(0x0E6F, 0x0186, False)
    source = ScriptedHid()
    assert_true(SwitchDriver.is_supported_device(source, third))
    assert_equal(len(source.log), 0)


def test_joycon_answer_is_refused() raises:
    """A third-party pad that says it is a Joy-Con does not start."""
    for device_type in [1, 2]:
        var device = _device(0x0E6F, 0x0186, False)
        var source = ScriptedHid()
        _queue(source, [_status(device_type)])
        var driver = SwitchDriver()
        assert_false(driver.init_device(device, source, Duration64(0)))
        assert_equal(device.joysticks, 0)


def test_classic_identity() raises:
    """The classic controllers that have a product id of their own get
    it, and their name.
    """
    var names: List[String] = [
        "Nintendo SNES Controller",
        "Nintendo N64 Controller",
        "Nintendo SEGA Genesis Controller",
    ]
    var products: List[Int] = [0x2017, 0x2019, 0x201E]
    for index in range(3):
        var device = _device(0x0E6F, 0x0186, False)
        var source = ScriptedHid()
        _queue(source, [_status(11 + index)])
        var driver = SwitchDriver()
        assert_true(driver.init_device(device, source, Duration64(0)))
        assert_equal(device.name, names[index])
        var info = joystick_guid_info(device.guid)
        assert_equal(info.vendor.value, 0x057E)
        assert_equal(info.product.value, products[index])
        assert_equal(Int(device.guid.data[15]), 11 + index)
        assert_equal(device.serial, "11-22-33-44-55-66")
        assert_equal(device.type, GAMEPAD_TYPE_STANDARD)
        assert_equal(device.joysticks, 1)


def test_identity_failure() raises:
    """A device whose GUID cannot be made again does not start."""
    var device = _device(0x057E, 0x2009, False)
    device.version = 0x10000
    var source = ScriptedHid()
    _queue(source, [_status(3), _status(3), _status(3)])
    var driver = SwitchDriver()
    assert_false(driver.init_device(device, source, Duration64(0)))


def test_bluetooth_waits_for_usb() raises:
    """A Bluetooth pad whose USB self has a driver connects when the USB
    device goes away.
    """
    var device = _device(0x0E6F, 0x0186, True, "66-55-44-33-22-11")
    device.usb_serials = ["66-55-44-33-22-11"]
    var source = ScriptedHid()
    _queue(source, ["3f", "3f"])
    source.failing = True
    var driver = SwitchDriver()
    assert_true(driver.init_device(device, source, Duration64(0)))
    assert_equal(device.joysticks, 0)
    var pad = Optional[Gamepad](None)
    source.failing = False
    assert_true(driver.update_device(device, source, pad, Duration64(0)))
    assert_equal(device.joysticks, 0)
    device.usb_serials = List[String]()
    _queue(source, ["3f"])
    assert_true(driver.update_device(device, source, pad, Duration64(0)))
    assert_equal(device.joysticks, 1)


def test_driver_without_joystick() raises:
    """A driver with no open joystick says what SDL's says."""
    var driver = SwitchDriver()
    var device = _device(0x057E, 0x2009, False)
    var source = ScriptedHid()
    assert_equal(driver.capabilities(device), 0)
    var joystick = Joystick("Pad", device.guid, 6, 16, 1)
    # No motion calibration was read.
    assert_false(driver.set_sensors_enabled(device, source, joystick, True))
    driver.sensors_supported = True
    # Enhanced reports are off until the joystick opens.
    assert_false(driver.set_sensors_enabled(device, source, joystick, True))
    source.failing = True
    assert_true(driver.set_sensors_enabled(device, source, joystick, False))
    # The report mode, then the motion sensors: five tries each.
    assert_equal(len(source.log), 10)
    # A player number waits for the joystick.
    driver.set_player_index(device, source, 2)
    assert_equal(driver.joystick_player_index, 2)
    assert_equal(len(source.log), 10)


def test_rumble_encoding() raises:
    """The amplitude codes follow SDL's tables."""
    assert_equal(encode_rumble_high_amplitude(0), 0x00)
    assert_equal(encode_rumble_high_amplitude(514), 0x02)
    assert_equal(encode_rumble_high_amplitude(515), 0x04)
    assert_equal(encode_rumble_high_amplitude(65535), 0xC8)
    assert_equal(encode_rumble_low_amplitude(0), 0x0040)
    assert_equal(encode_rumble_low_amplitude(1), 0x8040)
    assert_equal(encode_rumble_low_amplitude(30000), 0x0060)
    assert_equal(encode_rumble_low_amplitude(65535), 0x0072)


def _imu_rate_script(advance: Bool) -> String:
    """Return a script with 335 reports of motion data: 1005 samples.

    Args:
        advance: Whether 2 s pass before the 1000th sample.

    Returns:
        The script.
    """
    var script = String(IMU_RATE_PREFIX)
    for _ in range(200):
        script += IMU_REPORT + "\n"
    script += "update\n"
    if advance:
        script += "time 2000\n"
    for _ in range(134):
        script += IMU_REPORT + "\n"
    script += "update\n" + IMU_REPORT + "\nupdate\n"
    return script^


def _check_tail(transcript: String, lines: Int, tail: String) raises:
    """Compare a long transcript's length and end with the oracle's.

    Args:
        transcript: The transcript.
        lines: The oracle's line count.
        tail: The oracle's last 15 lines.

    Raises:
        Error: If they differ.
    """
    var split = transcript.split("\n")
    assert_equal(len(split), lines)
    var end = String("")
    for index in range(len(split) - 15, len(split)):
        if index > len(split) - 15:
            end += "\n"
        end += String(split[index])
    assert_equal(end, String(tail))


def test_imu_rate() raises:
    """After 1000 samples the driver measures the sample interval: 2 s over
    1002 samples. The oracle's queue held 256 reports, so it ran with a
    larger queue.
    """
    _check_tail(
        run_script(_imu_rate_script(True)), IMU_RATE_LINES, IMU_RATE_TAIL
    )


def test_imu_rate_frozen() raises:
    """A clock that did not move keeps the 5 ms sample interval."""
    _check_tail(
        run_script(_imu_rate_script(False)),
        IMU_RATE_FROZEN_LINES,
        IMU_RATE_FROZEN_TAIL,
    )


struct _ReadFails(HidSource):
    """A device that takes writes and fails every read."""

    var writes: Int

    def __init__(out self):
        """Create a device with no writes."""
        self.writes = 0

    @staticmethod
    def open(path: String) raises -> Self:
        """Open a device.

        Args:
            path: The path.

        Returns:
            The device.
        """
        return Self()

    def read(mut self, mut buffer: List[UInt8], milliseconds: Int) -> Int:
        """Fail.

        Args:
            buffer: The buffer.
            milliseconds: Ignored.

        Returns:
            -1.
        """
        return -1

    def write(mut self, data: List[UInt8]) -> Int:
        """Count a write.

        Args:
            data: The report.

        Returns:
            Its length.
        """
        self.writes += 1
        return len(data)

    def get_feature_report(mut self, mut buffer: List[UInt8]) -> Int:
        """Fail.

        Args:
            buffer: The buffer.

        Returns:
            -1.
        """
        return -1

    def send_feature_report(mut self, data: List[UInt8]) -> Int:
        """Fail.

        Args:
            data: The report.

        Returns:
            -1.
        """
        return -1


def test_read_errors_end_the_wait() raises:
    """A read error ends the wait for a reply, and the command is sent
    again.
    """
    var source = _ReadFails()
    assert_true(
        SwitchDriver.is_supported_device(source, _device(0x057E, 0x2009, False))
    )
    # Two questions, five tries each.
    assert_equal(source.writes, 10)
    source = _ReadFails()
    assert_true(
        SwitchDriver.is_supported_device(source, _device(0x057E, 0x2009, True))
    )
    assert_equal(source.writes, 10)


def test_joycon_probe_stops_the_start() raises:
    """The driver does not start on a pad that says it is a Joy-Con."""
    var device = _device(0x057E, 0x2009, False)
    var source = ScriptedHid()
    _queue(source, [_status(2)])
    var driver = SwitchDriver()
    assert_false(driver.init_device(device, source, Duration64(0)))
    assert_equal(device.joysticks, 0)


def test_pending_rumble_failure() raises:
    """Rumble fails when the rumble that waited cannot be written."""
    var driver = SwitchDriver()
    var device = _device(0x057E, 0x2009, False)
    var source = ScriptedHid()
    source.failing = True
    driver.rumble_pending = True
    driver.rumble_pending_value = 0x00010001
    driver.now_ns = 100_000_000
    assert_false(driver.rumble(device, source, 2, 2))
    assert_false(driver.rumble_pending)
    assert_equal(len(source.log), 1)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
