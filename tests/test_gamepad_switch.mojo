def test_usb() raises:
    """A USB Pro Controller: the handshake, the user stick calibration, the
    user motion offsets, full reports, the motion sensors, the player
    lights, and the calls the pad does not support."""
    assert_equal(run_script(USB_SCRIPT), _oracle(USB_EXPECTED))


def test_usb_factory() raises:
    """The factory stick calibration, read again after a reply for the wrong
    address, with values the flash never had. The pad starts with no report
    mode, so the driver sets the full one and gives back the simple one at
    the end."""
    assert_equal(run_script(USB_FACTORY_SCRIPT), _oracle(USB_FACTORY_EXPECTED))


def test_bt() raises:
    """A Bluetooth Pro Controller in the simple report mode: its buttons, hat
    and 16-bit sticks. It stays connected while it sends simple reports."""
    assert_equal(run_script(BT_SCRIPT), _oracle(BT_EXPECTED))


def test_bt_full() raises:
    """A Bluetooth pad in the full report mode that goes quiet for 3 s is
    disconnected. Its next report connects it again, and it opens again."""
    assert_equal(run_script(BT_FULL_SCRIPT), _oracle(BT_FULL_EXPECTED))


def test_input_only() raises:
    """A wired input only pad: no commands, its 7-byte reports, and no rumble.
    """
    assert_equal(run_script(INPUT_ONLY_SCRIPT), _oracle(INPUT_ONLY_EXPECTED))


def test_gamecube() raises:
    """A GameCube-style input only pad goes by its button labels."""
    assert_equal(run_script(GAMECUBE_SCRIPT), _oracle(GAMECUBE_EXPECTED))


def test_input_only_bt() raises:
    """An input only pad on Bluetooth is disconnected after 3 s without
    reports."""
    assert_equal(
        run_script(INPUT_ONLY_BT_SCRIPT), _oracle(INPUT_ONLY_BT_EXPECTED)
    )


def test_lic_pro() raises:
    """A licensed Pro Controller gets the Pro Controller's name, and SDL gives
    it no rumble capability."""
    assert_equal(run_script(LIC_PRO_SCRIPT), _oracle(LIC_PRO_EXPECTED))


def test_type5() raises:
    """A pad of a type SDL does not know is a standard gamepad."""
    assert_equal(run_script(TYPE5_SCRIPT), _oracle(TYPE5_EXPECTED))


def test_type7() raises:
    """An HVC controller (1): its name, its labels and no motion sensors."""
    assert_equal(run_script(TYPE7_SCRIPT), _oracle(TYPE7_EXPECTED))


def test_type8() raises:
    """An HVC controller (2)."""
    assert_equal(run_script(TYPE8_SCRIPT), _oracle(TYPE8_EXPECTED))


def test_type9() raises:
    """An NES controller (L)."""
    assert_equal(run_script(TYPE9_SCRIPT), _oracle(TYPE9_EXPECTED))


def test_type10() raises:
    """An NES controller (R)."""
    assert_equal(run_script(TYPE10_SCRIPT), _oracle(TYPE10_EXPECTED))


def test_fail_init() raises:
    """A device that fails from the start connects, then goes away in its first
    read."""
    assert_equal(run_script(FAIL_INIT_SCRIPT), _oracle(FAIL_INIT_EXPECTED))


def test_fail_bt() raises:
    """A Bluetooth device that fails from the start."""
    assert_equal(run_script(FAIL_BT_SCRIPT), _oracle(FAIL_BT_EXPECTED))


def test_fail_third_party() raises:
    """A third-party pad that fails from the start keeps its own name."""
    assert_equal(
        run_script(FAIL_THIRD_PARTY_SCRIPT), _oracle(FAIL_THIRD_PARTY_EXPECTED)
    )


def test_unplug() raises:
    """A pad that goes away while it is open is removed."""
    assert_equal(run_script(UNPLUG_SCRIPT), _oracle(UNPLUG_EXPECTED))


def test_unplug_late() raises:
    """A pad that goes away after 100 ms of silence is asked for USB reports
    first."""
    assert_equal(run_script(UNPLUG_LATE_SCRIPT), _oracle(UNPLUG_LATE_EXPECTED))


def test_bad_calibration() raises:
    """A pad that never sends the factory calibration does not open."""
    assert_equal(
        run_script(BAD_CALIBRATION_SCRIPT), _oracle(BAD_CALIBRATION_EXPECTED)
    )


def test_rumble() raises:
    """Rumble waits 30 ms between writes and keeps the strongest request, stops
    when asked, and is written again every 50 ms."""
    assert_equal(run_script(RUMBLE_SCRIPT), _oracle(RUMBLE_EXPECTED))


def test_rumble_fail() raises:
    """A rumble write that fails is reported."""
    assert_equal(run_script(RUMBLE_FAIL_SCRIPT), _oracle(RUMBLE_FAIL_EXPECTED))


def test_imu() raises:
    """Each accelerometer axis of the first sample shows that the sensors run.
    When they go quiet, the driver turns them on again at most every 3 s."""
    assert_equal(run_script(IMU_SCRIPT), _oracle(IMU_EXPECTED))


def test_imu_quiet() raises:
    """A pad that never sent motion data is not asked again."""
    assert_equal(run_script(IMU_QUIET_SCRIPT), _oracle(IMU_QUIET_EXPECTED))


def test_mode31() raises:
    """A pad that starts in the 0x31 report mode stays in it."""
    assert_equal(run_script(MODE31_SCRIPT), _oracle(MODE31_EXPECTED))


def test_replies() raises:
    """Reports that are not the awaited reply are skipped."""
    assert_equal(run_script(REPLIES_SCRIPT), _oracle(REPLIES_EXPECTED))


def test_hori_usb() raises:
    """The HORI Wireless Switch Pad on USB has no driver."""
    assert_equal(run_script(HORI_USB_SCRIPT), _oracle(HORI_USB_EXPECTED))


def test_timeout_usb() raises:
    """A USB pad that never answers does not open."""
    assert_equal(run_script(TIMEOUT_USB_SCRIPT), _oracle(TIMEOUT_USB_EXPECTED))


def test_timeout_bt() raises:
    """A Bluetooth pad that never answers does not open."""
    assert_equal(run_script(TIMEOUT_BT_SCRIPT), _oracle(TIMEOUT_BT_EXPECTED))


def test_timeout_imu() raises:
    """A pad that sends no motion calibration gets SDL's default scales, and
    opens without the other replies."""
    assert_equal(run_script(TIMEOUT_IMU_SCRIPT), _oracle(TIMEOUT_IMU_EXPECTED))


def test_timeout_imu_user() raises:
    """A pad that sends no user motion offsets keeps the factory ones."""
    assert_equal(
        run_script(TIMEOUT_IMU_USER_SCRIPT), _oracle(TIMEOUT_IMU_USER_EXPECTED)
    )


