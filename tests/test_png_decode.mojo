def test_a_gamma_above_the_srgb_band_is_not_guessed_at_either() raises:
    # The band has two ends, and each has to be able to reject on its own.
    var image = decode(high_gamma_png())
    assert_equal(image.color_space, UNKNOWN_SPACE)


def test_an_empty_palette_is_rejected() raises:
    with assert_raises():
        _ = decode(empty_palette_png())


def test_neither_greyscale_type_may_carry_a_palette() raises:
    with assert_raises():
        _ = decode(palette_on_grey_alpha_png())


