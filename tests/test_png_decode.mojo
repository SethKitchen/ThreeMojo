def test_a_file_of_nothing_but_a_signature_is_rejected() raises:
    with assert_raises():
        _ = decode(signature_only_png())


def test_a_chunk_length_with_its_top_bit_set_is_rejected() raises:
    # PNG lengths are unsigned and capped at 2^31 - 1. Read as signed, a
    # larger one is negative, and every bound derived from it is wrong in a
    # direction that lets reads through.
    with assert_raises():
        _ = decode(negative_length_png())


def test_either_dimension_alone_can_be_too_large() raises:
    # Each operand of the check has to be able to decide the outcome alone.
    with assert_raises():
        _ = decode(tall_png())
    with assert_raises():
        _ = decode(giant_png())


def test_allowed_dimensions_can_still_ask_for_too_many_pixels() raises:
    # 65536 on a side passes both dimension checks and asks for four billion
    # pixels, which is the multiply that overflows before it allocates.
    with assert_raises():
        _ = decode(too_many_pixels_png())


def test_a_palette_after_the_pixel_data_is_rejected() raises:
    with assert_raises():
        _ = decode(late_palette_png())


def test_a_second_palette_is_rejected() raises:
    with assert_raises():
        _ = decode(two_palettes_png())


def test_a_trns_after_the_pixel_data_is_rejected() raises:
    with assert_raises():
        _ = decode(late_trns_png())


def test_a_second_trns_is_rejected() raises:
    with assert_raises():
        _ = decode(two_trns_png())


def test_a_palette_trns_before_its_palette_is_rejected() raises:
    # It is sized against the palette, so it cannot be checked before one
    # has arrived -- and accepting it unchecked is what this whole round of
    # validation is about.
    with assert_raises():
        _ = decode(palette_trns_before_palette_png())


def test_colour_chunks_after_the_pixel_data_are_rejected() raises:
    # They describe how to read samples that have already been read.
    with assert_raises():
        _ = decode(late_srgb_png())
    with assert_raises():
        _ = decode(late_gama_png())
    with assert_raises():
        _ = decode(late_iccp_png())


def test_a_gama_chunk_of_the_wrong_size_is_rejected() raises:
    with assert_raises():
        _ = decode(short_gama_png())


def test_the_sRGB_gamma_is_recognised_on_its_own() raises:
    # 45455 is the 1/2.2 that stands for ordinary sRGB content, and plenty of
    # files carry it with no sRGB chunk at all.
    var image = decode(srgb_gamma_png())
    assert_equal(image.color_space, SRGB)


def test_reading_outside_a_decoded_image_is_rejected() raises:
    # Each of the four operands has to be able to decide the outcome alone.
    var image = decode(rgba_png())
    with assert_raises():
        _ = image.get_pixel(-1, 0)
    with assert_raises():
        _ = image.get_pixel(4, 0)
    with assert_raises():
        _ = image.get_pixel(0, -1)
    with assert_raises():
        _ = image.get_pixel(0, 4)


