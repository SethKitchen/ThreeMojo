# --- Structure, not just chunks ---------------------------------------------
#
# A PNG is an ordered sequence and the order carries meaning. Reading chunks
# in whatever order they arrive, and using whatever they contain, is how a
# malformed file reaches arithmetic written for a well-formed one.


def test_a_short_grey_trns_is_rejected_rather_than_read_past() raises:
    # This aborted the process. tRNS on a greyscale image is two bytes; a
    # one-byte chunk left an empty key that the pixel loop then indexed, so a
    # CRC-valid file reached an out-of-range read rather than an error.
    with assert_raises():
        _ = decode(short_grey_trns_png())


def test_a_short_rgb_trns_is_rejected_rather_than_read_past() raises:
    # The same, one channel further along: six bytes are required and two
    # were given, so key[1] was read off the end.
    with assert_raises():
        _ = decode(short_rgb_trns_png())


def test_a_second_header_is_rejected() raises:
    with assert_raises():
        _ = decode(two_headers_png())


def test_a_file_that_does_not_begin_with_its_header_is_rejected() raises:
    with assert_raises():
        _ = decode(header_not_first_png())


def test_pixel_data_must_arrive_in_one_run() raises:
    with assert_raises():
        _ = decode(split_data_png())


def test_an_unknown_critical_chunk_is_rejected() raises:
    # An uppercase first letter means the file cannot be read correctly
    # without understanding the chunk. Skipping one is guessing; tEXt and
    # friends are lowercase precisely so they *can* be skipped.
    with assert_raises():
        _ = decode(unknown_critical_png())


def test_a_chunk_after_the_end_marker_is_rejected() raises:
    with assert_raises():
        _ = decode(chunk_after_end_png())


def test_an_end_marker_with_a_payload_is_rejected() raises:
    with assert_raises():
        _ = decode(fat_end_png())


def test_a_palette_that_is_not_whole_entries_is_rejected() raises:
    with assert_raises():
        _ = decode(ragged_palette_png())


def test_a_greyscale_image_may_not_carry_a_palette() raises:
    with assert_raises():
        _ = decode(palette_on_grey_png())


def test_an_image_with_alpha_may_not_also_carry_trns() raises:
    with assert_raises():
        _ = decode(trns_on_rgba_png())


def test_a_palette_trns_longer_than_its_palette_is_rejected() raises:
    with assert_raises():
        _ = decode(long_palette_trns_png())


def test_an_image_too_large_to_build_is_refused_by_name() raises:
    # Four bytes per dimension, so a header asks for ten billion pixels in
    # thirteen bytes. Refused before anything is allocated -- and before the
    # multiply that sizes the buffer can overflow.
    with assert_raises():
        _ = decode(giant_png())


# --- The zlib layer, which a chunk CRC says nothing about --------------------


def test_a_missing_adler_is_rejected() raises:
    # Two layers: the chunk CRC says the compressed bytes survived the
    # journey, the Adler-32 says they decompress to what the encoder meant.
    # These fixtures have correct chunk CRCs, so only the inner check can
    # catch them -- and it was not being made.
    with assert_raises():
        _ = decode(no_adler_png())


def test_a_wrong_adler_is_rejected() raises:
    with assert_raises():
        _ = decode(wrong_adler_png())


def test_a_window_larger_than_deflate_defines_is_rejected() raises:
    with assert_raises():
        _ = decode(huge_window_png())


def test_a_stream_that_expands_past_its_header_is_stopped_as_it_does() raises:
    # A one-pixel RGBA image is five bytes: one filter byte and four
    # channels. This stream expands to sixteen thousand. The size was
    # checked after decompressing, which is too late to be a limit -- the
    # work is done and the memory is held by then.
    with assert_raises():
        _ = decode(oversized_stream_png())


def run_deflate() -> List[UInt8]:
    """A raw DEFLATE stream expanding to forty identical bytes.

    Raw rather than zlib-wrapped so the limit can be tested without the
    checksum passing judgement first. The run is stored as one byte and a
    back-reference, so expanding it goes through the match path rather
    than the literal path."""
    return [
        UInt8(99),
        UInt8(103),
        UInt8(39),
        UInt8(14),
        UInt8(0),
        UInt8(0),
    ]


def test_the_limit_applies_to_a_back_reference_too() raises:
    # Literals and matches are different append paths, and a bound on only
    # one of them is not a bound. A run of identical bytes is the match path.
    # Straight at the inflater, where the limit lives.
    with assert_raises():
        _ = inflate(run_deflate(), 0, 4)
    # And the same stream with room to spare is fine.
    var whole = inflate(run_deflate(), 0, 64)
    assert_equal(len(whole), 40)


# --- What the samples mean ---------------------------------------------------


def test_an_untagged_file_is_taken_as_srgb() raises:
    var image = decode(rgba_png())
    assert_equal(image.color_space, SRGB)


def test_a_gamma_of_one_means_the_samples_are_linear() raises:
    # PNG does not imply sRGB. A mid grey of 128 in a linear image is half
    # the light; decoding it through the sRGB curve makes it a fifth, and
    # nothing later can tell the difference.
    var image = decode(linear_grey_png())
    assert_equal(image.color_space, LINEAR)
    assert_equal(image.get_pixel(0, 0).r, UInt8(128))
    # Read as declared, 128 is 0.502 of the light, which displays as 188.
    var linear = texture_from(image, REPEAT, NEAREST)
    assert_almost_equal(
        linear.sample(0.5, 0.5).r, Float32(128) / 255, atol=Float64(1e-6)
    )
    # Read as sRGB it would be 0.216 -- the error this contract prevents.
    var wrong = texture_from(image, REPEAT, NEAREST, SRGB)
    assert_almost_equal(
        wrong.sample(0.5, 0.5).r, Float32(0.215861), atol=Float64(1e-5)
    )


def test_an_srgb_chunk_outranks_a_contradicting_gamma() raises:
    var image = decode(srgb_tagged_png())
    assert_equal(image.color_space, SRGB)


def test_a_gamma_that_is_neither_is_not_guessed_at() raises:
    var image = decode(odd_gamma_png())
    assert_equal(image.color_space, UNKNOWN_SPACE)
    # And the caller has to settle it rather than get a silent default.
    with assert_raises():
        _ = texture_from(image)
    var settled = texture_from(image, REPEAT, NEAREST, SRGB)
    assert_equal(settled.width, 1)


def test_an_icc_profile_is_reported_rather_than_ignored() raises:
    # Not refused: the file is readable and the caller may well know what it
    # is for. Refusing to guess is the whole of the contract.
    var image = decode(profiled_png())
    assert_equal(image.color_space, UNKNOWN_SPACE)
    with assert_raises():
        _ = texture_from(image)


