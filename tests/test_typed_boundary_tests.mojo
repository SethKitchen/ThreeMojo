"""The typed-boundary tests keep their reviewed digests."""

from std.pathlib import Path
from std.testing import TestSuite, assert_raises

from tools._process import run_program
from tools.typed_boundary_tests import typed_boundary_tests


def _copy(root: String) raises:
    """Copy the reviewed tests.

    Args:
        root: The temporary repository.

    Raises:
        Error: A file cannot be copied.
    """
    var cleared = run_program(["rm", "-rf", root], 10.0)
    if cleared.status != 0:
        raise Error(cleared.output)
    var made = run_program(
        [
            "mkdir",
            "-p",
            root + "/tests/compile_fail",
        ],
        10.0,
    )
    if made.status != 0:
        raise Error(made.output)
    var files = List[String]()
    files.append("tests/_lazy_taylor_controls.mojo")
    files.append("tests/_published_lane_refinement.mojo")
    files.append("tests/_reference_spiral_domain_validation.mojo")
    files.append("tests/_spiral_acceptance_controls.mojo")
    files.append("tests/carla_fixed_s_fixture.mojo")
    files.append("tests/compile_fail/a_lane_change_is_not_a_bare_int.mojo")
    files.append("tests/compile_fail/a_lane_id_is_not_a_bare_int.mojo")
    files.append(
        "tests/compile_fail/a_lane_marking_color_is_not_a_bare_int.mojo"
    )
    files.append(
        "tests/compile_fail/a_lane_marking_type_is_not_a_bare_int.mojo"
    )
    files.append("tests/compile_fail/a_lane_type_is_not_a_bare_int.mojo")
    files.append("tests/compile_fail/a_mark_lane_change_is_not_a_bare_int.mojo")
    files.append(
