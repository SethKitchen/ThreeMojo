    for path in files:
        var copied = run_program(["cp", path, root + "/" + path], 10.0)
        if copied.status != 0:
            raise Error(copied.output)


def test_the_live_tests_hold() raises:
    """The 352 tests keep their reviewed digests."""
    typed_boundary_tests(".")
    typed_boundary_tests("./")
    typed_boundary_tests("extensions/..")


def test_a_changed_lazy_taylor_control_is_refused() raises:
    """A changed lazy Taylor control is refused."""
    var root = "/tmp/typed-boundary-tests-lazy"
    _copy(root)
    var path = root + "/tests/_lazy_taylor_controls.mojo"
    Path(path).write_text(Path(path).read_text() + "\n")
    with assert_raises(
        contains=(
            "typed boundary bound input changed: "
            + "tests/_lazy_taylor_controls.mojo"
        )
    ):
        typed_boundary_tests(root)


def test_a_changed_spiral_selection_test_is_refused() raises:
    """A changed spiral selection test is refused."""
    var root = "/tmp/typed-boundary-tests-spiral"
    _copy(root)
    var path = root + "/tests/test_spiral_selection_finite_contract.mojo"
    Path(path).write_text(Path(path).read_text() + "\n")
    with assert_raises(
        contains=(
            "typed boundary bound input changed: "
            + "tests/test_spiral_selection_finite_contract.mojo"
        )
    ):
        typed_boundary_tests(root)


def main() raises:
    """Run the typed-boundary test checks."""
    TestSuite.discover_tests[__functions_in_module()]().run()
