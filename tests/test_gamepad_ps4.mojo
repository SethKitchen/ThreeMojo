        "own:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,guide:b5,leftshoulde"
        "r:b9,leftstick:b7,lefttrigger:a4,leftx:a0,lefty:a1,rightshoulder"
        ":b10,rightstick:b8,righttrigger:a5,rightx:a2,righty:a3,start:b6,"
        "x:b2,y:b3,touchpad:b11,crc:e58f,platform:Linux,\n"
        "counts 6 12 1\n"
        "touchpads 1 2\n"
        "sensors 1:250.0 2:250.0\n"
        "caps 0 1 0 1 0\n"
        "axes 0 0 0 0 -32768 -32768\n"
        "buttons 000000000000\n"
        "hats 0\n"
        "> fail\n"
        "> rumble 65535 0 0\n"
        "write 0507000000ff0000400000000000000000000000000000000000000000"
        "000000\n"
        "result 0\n"
        "> led 1 2 3\n"
        "write 0507000000ff0102030000000000000000000000000000000000000000"
        "000000\n"
        "result 0\n"
        "hid close\n"
    )
    assert_equal(run_script(script), expected)


# An enhanced Bluetooth state report at rest, with its CRC.
comptime BLUETOOTH_REPORT = (
    "11c00080808080080000000000000000000000000000000000000000000000"
    "000000000000800000008000000000000000000000000000000000000000000000"
    "000000000000000000006ca6f554"
)


def _device(
    vendor: Int, product: Int, serial: String, bluetooth: Bool
) raises -> HidapiDevice:
    return HidapiDevice(
        HidDeviceInfo(
            "/dev/hidraw0",
            VendorId(vendor),
            ProductId(product),
            0x100,
            serial,
            "",
            "",
            1,
            5,
            -1 if bluetooth else 0,
            HID_BUS_BLUETOOTH if bluetooth else HID_BUS_USB,
        )
    )


def _capabilities(magic: String, length: Int) -> List[UInt8]:
    var report = hex_bytes("0300" + magic + "004e")
    report.resize(length, 0)
    return report^


def test_the_driver_may_run_ps4_pads_and_playstation_makers() raises:
    assert_true(
        Ps4Driver.is_supported(
            "", GAMEPAD_TYPE_PS4, VendorId(0x054C), ProductId(0x09CC), 0, -1
        )
    )
    assert_true(
        Ps4Driver.is_supported(
            "", GAMEPAD_TYPE_STANDARD, VendorId(0x0F0D), ProductId(0x1234), 0, 0
        )
    )
    assert_false(
        Ps4Driver.is_supported(
            "", GAMEPAD_TYPE_PS5, VendorId(0x054C), ProductId(0x0CE6), 0, 0
        )
    )


def test_an_open_device_must_answer_the_capability_report() raises:
    var source = ScriptedHid()
    var hori = _device(0x0F0D, 0x1234, "", False)
    # No answer, a short one, then a DualSense's.
    assert_false(Ps4Driver.is_supported_device(source, hori))
    source.features[3] = _capabilities("27", 40)
    assert_false(Ps4Driver.is_supported_device(source, hori))
    source.features[3] = _capabilities("28", 48)
    assert_false(Ps4Driver.is_supported_device(source, hori))
    source.features[3] = _capabilities("27", 48)
    assert_true(Ps4Driver.is_supported_device(source, hori))
    assert_equal(len(source.log), 4)
    assert_equal(source.log[0], "feature-get 03 64")
    # A PS4 pad needs no question, and an unknown company gets none.
    assert_true(
        Ps4Driver.is_supported_device(
            source, _device(0x054C, 0x09CC, "", False)
        )
    )
    assert_false(
        Ps4Driver.is_supported_device(
            source, _device(0x1234, 0x5678, "", False)
        )
    )
    assert_equal(len(source.log), 4)


def test_a_bluetooth_pad_waits_for_its_usb_link_to_go() raises:
    var source = ScriptedHid()
    var device = _device(0x054C, 0x09CC, "aabbccddeeff", True)
    device.usb_serials = ["aa-bb-cc-dd-ee-ff"]
    var driver = Ps4Driver()
    assert_true(driver.init_device(device, source, Duration64(0, SECOND)))
    assert_equal(device.serial, "aa-bb-cc-dd-ee-ff")
    assert_equal(device.joysticks, 0)
    var pad = Optional[Gamepad](None)
    source.queue.append(hex_bytes(BLUETOOTH_REPORT))
    assert_true(
        driver.update_device(device, source, pad, Duration64(0.1, SECOND))
    )
    assert_equal(device.joysticks, 0)
    device.usb_serials = List[String]()
    source.queue.append(hex_bytes(BLUETOOTH_REPORT))
    assert_true(
        driver.update_device(device, source, pad, Duration64(0.2, SECOND))
    )
    assert_equal(device.joysticks, 1)
    assert_equal(len(source.log), 0)


# A good USB calibration report.
comptime CALIBRATION_REPORT = (
    "020100feff0300401fc0e0a41f5ce0dc1e24e11c021c02002000e008200ce0fe1ffedf0000"
)


struct CalibrationHid(HidSource):
    """A pad whose calibration report can be all zeros, its id included."""

    var blank: Bool
    var requests: Int

    def __init__(out self):
        self.blank = False
        self.requests = 0

    @staticmethod
    def open(path: String) raises -> Self:
        return CalibrationHid()

    def read(mut self, mut buffer: List[UInt8], milliseconds: Int) -> Int:
        return 0

    def write(mut self, data: List[UInt8]) -> Int:
        return len(data)

    def get_feature_report(mut self, mut buffer: List[UInt8]) -> Int:
        if buffer[0] != 0x02:
            return -1
        self.requests += 1
        var report = hex_bytes(CALIBRATION_REPORT)
        for index in range(len(report)):
            buffer[index] = 0 if self.blank else report[index]
        return len(report)

    def send_feature_report(mut self, data: List[UInt8]) -> Int:
        return len(data)


def test_a_blank_calibration_is_asked_for_five_times() raises:
    var source = CalibrationHid()
    var device = _device(0x054C, 0x09CC, "", False)
    var driver = Ps4Driver()
    var now = Duration64(0, SECOND)
    assert_true(driver.init_device(device, source, now))
    # No enhanced mode, so no light bar or rumble, before the pad opens.
    assert_equal(driver.capabilities(device), 0)
    var joystick = driver.open_joystick(device, source, now)
    source.blank = True
    assert_true(driver.set_sensors_enabled(device, source, joystick, True))
    assert_equal(source.requests, 5)
    assert_false(driver.hardware_calibration)
    # A blank report after a good one keeps the good one, as in SDL.
    source.blank = False
    assert_true(driver.set_sensors_enabled(device, source, joystick, True))
    assert_true(driver.hardware_calibration)
    source.blank = True
    assert_true(driver.set_sensors_enabled(device, source, joystick, True))
    assert_true(driver.hardware_calibration)
    assert_equal(source.requests, 11)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
