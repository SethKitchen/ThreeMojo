    var expected = String(
        "> device 54c 9cc 100 usb 3 1 5\n"
        "> strings Sony Interactive Entertainment|Wireless Controller|\n"
        "> open\n"
        "hid open\n"
        "feature-get 12 64\n"
        "write 0507000000000000400000000000000000000000000000000000000000"
        "000000\n"
