def test_a_large_bias_drops_the_calibration() raises:
    var script = String(
        "device 54c 9cc 100 usb 3 1 5\n"
        "strings Sony Interactive Entertainment|Wireless Controller|\n"
        "feature 02d00700000000401fc0e0a41f5ce0dc1e24e11c021c02002000e008"
        "200ce0fe1ffedf0000\n"
        "open\n"
        "sensors 1\n"
        "input 018080808008000000000a00006400c8002c019001f401580200000000"
        "0000000000008000000080000000000000000000000000000000000000000000"
        "000000\n"
        "update\n"
    )
    var expected = String(
        "> device 54c 9cc 100 usb 3 1 5\n"
        "> strings Sony Interactive Entertainment|Wireless Controller|\n"
        "> feature 02d00700000000401fc0e0a41f5ce0dc1e24e11c021c02002000e0"
        "08200ce0fe1ffedf0000\n"
        "> open\n"
        "hid open\n"
        "feature-get 12 64\n"
        "write 0507000000000000400000000000000000000000000000000000000000"
        "000000\n"
        "name PS4 Controller\n"
        "guid 03008fe54c050000cc09000000016800\n"
        "type 5\n"
        "mapping 03008fe54c050000cc09000000016800,*,a:b0,b:b1,back:b4,dpd"
        "own:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,guide:b5,leftshoulde"
        "r:b9,leftstick:b7,lefttrigger:a4,leftx:a0,lefty:a1,rightshoulder"
        ":b10,rightstick:b8,righttrigger:a5,rightx:a2,righty:a3,start:b6,"
        "x:b2,y:b3,touchpad:b11,crc:e58f,platform:Linux,\n"
        "counts 6 12 1\n"
        "touchpads 1 2\n"
        "sensors 1:250.0 2:250.0\n"
        "caps 0 1 0 1 0\n"
        "axes 0 0 0 0 -32768 -32768\n"
        "buttons 000000000000\n"
        "hats 0\n"
        "> sensors 1\n"
        "feature-get 02 64\n"
        "result 1\n"
        "result 1\n"
        "> input 018080808008000000000a00006400c8002c019001f4015802000000"
        "0000000000000080000000800000000000000000000000000000000000000000"
        "00000000\n"
        "> update\n"
        "sensor 2 0.1091 0.2182 0.3272 53333\n"
        "sensor 1 0.4788 0.5986 0.7183 53333\n"
        "axes 0 0 0 0 -32768 -32768\n"
        "buttons 000000000000\n"
        "hats 0\n"
        "hid close\n"
    )
    assert_equal(run_script(script), expected)


