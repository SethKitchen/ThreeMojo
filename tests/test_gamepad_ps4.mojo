"""Tests for the DualShock 4 HIDAPI driver.

Each script test runs a scripted device through the driver and compares
the whole transcript with the one SDL 3.2.24's own driver prints for the
same script. The oracle is `hid.c` with two changes: SDL's PS3 driver is
off, because ThreeMojo has no PS3 driver to read the third-party
detection report first, and a removed gamepad prints one `removed` line,
as `run_script` does, where SDL sends a joystick and a gamepad event.

A device that the driver turns down goes on to the DualSense driver,
which reads the same report, so the tests at the end call the driver
directly for those, and for a Bluetooth pad that waits for its USB link
to go.
"""

from std.testing import TestSuite, assert_equal, assert_false, assert_true
from extensions.gamepad.gamepad import Gamepad
from extensions.gamepad.guid import ProductId, VendorId
from extensions.gamepad.hid import (
    HID_BUS_BLUETOOTH,
    HID_BUS_USB,
    HidDeviceInfo,
    HidSource,
)
from extensions.gamepad.hid_device import HidapiDevice
from extensions.gamepad.hid_ps4 import Ps4Driver
from extensions.gamepad.ids import (
    GAMEPAD_TYPE_PS4,
    GAMEPAD_TYPE_PS5,
    GAMEPAD_TYPE_STANDARD,
)
from tests._gamepad_hid_script import ScriptedHid, hex_bytes, run_script
from units.si import Duration64, SECOND


