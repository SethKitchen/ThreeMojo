            0xE96360F5,
            0xEFACC953,
            0x2F43FC34,
            0x67697E73,
            0xB6CCCC23,
            0x2EC3FC34,
            0xE8D4C90E,
            0xEF2CC953,
            0x6F2CC954,
        ]
    )
    cases.append(
        [
            0xB28C3767,
            0xD7BDB64C,
            0xF99796AC,
            0xA071D5A5,
            0x66E91E40,
            0x23DDC708,
            0xB20C3767,
            0x66691E40,
            0xF91796AC,
            0x791796AD,
        ]
    )
    cases.append(
        [
            0xB9601BDE,
            0x878BA924,
            0xEEA55E20,
            0x8F1CC9E8,
            0x0D4ECBD4,
            0x3751D981,
            0xB8E01BDE,
            0x0CCEBA5F,
            0xEE255E20,
            0x6E255E21,
        ]
    )
    cases.append(
        [
            0xF38C9E85,
            0x93B788CE,
            0x1B153898,
            0xBF290E3C,
            0x8C584395,
            0x5CEC4321,
            0xF30C9E85,
            0x93378A7F,
            0x5C6C4321,
            0x730C9E86,
        ]
    )
    for row in cases:
        var low = Vector3(
            bitcast[DType.float32](row[0]),
            bitcast[DType.float32](row[1]),
            bitcast[DType.float32](row[2]),
        )
        var high = Vector3(
            bitcast[DType.float32](row[3]),
            bitcast[DType.float32](row[4]),
            bitcast[DType.float32](row[5]),
        )
        var box = Box3(low, high)
        var middle = box.center()
        assert_equal(bitcast[DType.uint32](middle.x), row[6])
        assert_equal(bitcast[DType.uint32](middle.y), row[7])
        assert_equal(bitcast[DType.uint32](middle.z), row[8])
        var flat = Box2(Vector2(low.x, low.y), Vector2(high.x, high.y)).center()
        assert_equal(bitcast[DType.uint32](flat.x), row[6])
        assert_equal(bitcast[DType.uint32](flat.y), row[7])
        var ball = box.bounding_sphere()
        assert_true(ball.center == middle)
        var encoded = bitcast[DType.uint32](ball.radius)
        assert_true(encoded >= row[9])
        assert_true(encoded <= row[9] + UInt32(1))
        if row[9] == 0:
            assert_equal(encoded, UInt32(0))
        if row[9] == 0x7F800000:
            assert_equal(encoded, UInt32(0x7F800000))
        else:
            assert_true(isfinite(ball.radius))


def test_empty_and_nonfinite_bounds_keep_their_contract() raises:
    assert_true(Box3.empty().center() == Vector3(0, 0, 0))
    assert_true(Box2.empty().center() == Vector2(0, 0))
    assert_true(Box3.empty().bounding_sphere().is_empty())
    var infinity = inf[DType.float32]()
    for axis in range(6):
        var low = Vector3(-1, -1, -1)
        var high = Vector3(1, 1, 1)
        if axis == 0:
            low.x = -infinity
        elif axis == 1:
            low.y = -infinity
        elif axis == 2:
            low.z = -infinity
        elif axis == 3:
            high.x = infinity
        elif axis == 4:
            high.y = infinity
        else:
            high.z = infinity
        assert_equal(Box3(low, high).bounding_sphere().radius, infinity)
    var unbounded = Box3(
        Vector3(-infinity, -infinity, -infinity),
        Vector3(infinity, infinity, infinity),
    )
    assert_true(isnan(unbounded.center().x))
    assert_equal(unbounded.bounding_sphere().radius, infinity)


def test_finite_radius_can_outlive_an_unrepresentable_full_extent() raises:
    var largest = bitcast[DType.float32](UInt32(0x7F7FFFFF))
    var box = Box3(Vector3(-largest, 0, 0), Vector3(largest, 0, 0))
    assert_equal(box.size().x, inf[DType.float32]())
    assert_equal(box.bounding_sphere().radius, largest)
    assert_true(box.center() == Vector3(0, 0, 0))
    var negative_zero = bitcast[DType.float32](UInt32(0x80000000))
    var point = Vector3(negative_zero, negative_zero, negative_zero)
    assert_equal(
        bitcast[DType.uint32](Box3(point, point).center().x), UInt32(0x80000000)
    )


def test_large_translated_gaussian_has_its_analytic_hit() raises:
    var shape = GaussianSplat(
        create_gaussian_splat_geometry(
            [3e38, 0, 0], [1, 0, 0, 1, 0, 1], [255, 255, 255, 255]
        ),
        NodeId(0),
    )
    var hits = shape.raycast(
        Matrix4(), Raycaster(Vector3(3e38, 0, 5), Vector3(0, 0, -1))
    )
    assert_equal(len(hits), 1)
    assert_equal(hits[0].point.x, Float32(3e38))
    assert_equal(hits[0].point.y, Float32(0))
    # The documented regularized unit covariance has radius 2*sqrt(1.0001).
    assert_almost_equal(
        Float64(hits[0].point.z), 2 * sqrt(Float64(1.0001)), atol=1e-6, rtol=0
    )
    assert_true(isfinite(shape.bounding_sphere.value().center.x))


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
