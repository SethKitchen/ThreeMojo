+                        context.frozen.value(),
+                        center_s,
+                        context.location,
+                        policy.scale,
+                    )
+                else:
+                    center = _expansion_distance_jet(
+                        road,
+                        context.section,
+                        context.lane,
+                        center_s,
+                        context.location,
